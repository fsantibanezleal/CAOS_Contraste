{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/benchmark-methods.schema.json",
  "title": "Methods compared",
  "description": "Catalog row benchmark-methods 2.0.0: the methods of each benchmark question side by side (data/derived/benchmark/methods-compared.json), every value copied from a committed case document or manuscript result file with its path, JSON pointer and SHA-256, every method with its standing read from the SDD method ladder, every reading generated from the numbers by the declared rule of each metric.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "schema_version",
    "provenance",
    "questions",
    "left_out",
    "not_built"
  ],
  "properties": {
    "case_id": {
      "const": "BENCHMARK-METHODS"
    },
    "schema": {
      "const": "contraste.benchmark.methods-compared/v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "provenance": {
      "$ref": "#/$defs/bmProvenance"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bmQuestion"
      }
    },
    "left_out": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bmLeftOut"
      }
    },
    "not_built": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bmNotBuilt"
      }
    }
  },
  "x-location": "data/derived/benchmark/methods-compared.json",
  "$defs": {
    "bmText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bmSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bmLadderId": {
      "type": "string",
      "pattern": "^(M|BS)-\\d+$"
    },
    "bmCite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "pointer",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository path of the committed file the value was copied from."
        },
        "pointer": {
          "type": "string",
          "description": "RFC 6901 JSON pointer of the value in that file."
        },
        "sha256": {
          "$ref": "#/$defs/bmSha256"
        }
      }
    },
    "bmProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_version",
        "generators",
        "ladder",
        "documents",
        "hash_rule"
      ],
      "properties": {
        "code_version": {
          "type": "string"
        },
        "generators": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "ladder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "rows_sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "rows_sha256": {
              "$ref": "#/$defs/bmSha256"
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/bmSha256"
              }
            }
          }
        },
        "hash_rule": {
          "type": "string"
        }
      }
    },
    "bmSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "cited"
      ],
      "properties": {
        "value": {
          "type": "integer"
        },
        "cited": {
          "$ref": "#/$defs/bmCite"
        }
      }
    },
    "bmColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/bmText"
        }
      }
    },
    "bmRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "protocol",
        "seed",
        "files",
        "truth_status",
        "columns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/bmText"
        },
        "protocol": {
          "$ref": "#/$defs/bmText"
        },
        "seed": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bmSeed"
            }
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The committed files this run's cells cite; no file serves two runs of one question."
        },
        "truth_status": {
          "type": "string",
          "enum": [
            "real-outcomes",
            "synthetic-known-truth",
            "synthetic-calibrated",
            "published-answer"
          ],
          "description": "What the data of this run rest on, the closed list of the case documents' provenance.truth_status: copied from the case documents the run cites (they must agree), or, for a run that cites manuscript result files only, declared by the specification with its reason."
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bmColumn"
          }
        }
      }
    },
    "bmMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "run_id",
        "better",
        "unit",
        "columns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "$ref": "#/$defs/bmText"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "better": {
          "type": "string",
          "pattern": "^(lower|higher|none|nearer:-?[0-9]+(\\.[0-9]+)?|nearer-metric:[a-z0-9_]+|order:[a-z_]+(,[a-z_]+)+)$",
          "description": "The declared rule: lower, higher, nearer:<value>, nearer-metric:<metric>, order:<best>,... or none (context, never ranked)."
        },
        "unit": {
          "$ref": "#/$defs/bmText"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "bmCell": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "column",
            "value",
            "null_reason",
            "cited"
          ],
          "properties": {
            "metric": {
              "type": "string"
            },
            "column": {
              "type": "string"
            },
            "value": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            "null_reason": {
              "type": "null"
            },
            "cited": {
              "$ref": "#/$defs/bmCite"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "column",
            "value",
            "null_reason",
            "cited"
          ],
          "properties": {
            "metric": {
              "type": "string"
            },
            "column": {
              "type": "string"
            },
            "value": {
              "type": "null"
            },
            "null_reason": {
              "$ref": "#/$defs/bmText"
            },
            "cited": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/bmCite"
                }
              ]
            }
          }
        }
      ]
    },
    "bmSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "url"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bmRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "method",
        "ladder_id",
        "standing",
        "ranked",
        "note",
        "source",
        "year",
        "cells"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "$ref": "#/$defs/bmText"
        },
        "ladder_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bmLadderId"
            }
          ],
          "description": "The SDD method-ladder id: kept for the tests, never rendered."
        },
        "standing": {
          "type": "string",
          "enum": [
            "established",
            "recent",
            "proposed",
            "reference"
          ],
          "description": "Read from the tier of the ladder row; reference when the row has no ladder id."
        },
        "ranked": {
          "type": "boolean"
        },
        "note": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bmText"
            }
          ]
        },
        "source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bmSource"
            }
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bmCell"
          }
        }
      },
      "if": {
        "properties": {
          "ladder_id": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "standing": {
            "const": "reference"
          }
        }
      },
      "else": {
        "properties": {
          "standing": {
            "enum": [
              "established",
              "recent",
              "proposed"
            ]
          }
        }
      }
    },
    "bmAbsent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "ladder_id",
        "standing",
        "reason",
        "backlog"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/bmText"
        },
        "ladder_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bmLadderId"
            }
          ]
        },
        "standing": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "established",
            "recent",
            "proposed",
            null
          ]
        },
        "reason": {
          "$ref": "#/$defs/bmText"
        },
        "backlog": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bmStanding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "column",
        "best",
        "value",
        "tie",
        "n_ranked"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "column": {
          "type": "string"
        },
        "best": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "tie": {
          "type": "boolean"
        },
        "n_ranked": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "bmNegativeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "manuscript",
        "concept_doi",
        "text"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "manuscript": {
          "type": "string",
          "minLength": 1
        },
        "concept_doi": {
          "type": "string",
          "pattern": "^10\\.5281/zenodo\\.\\d+$",
          "description": "The concept DOI of the manuscript, read from its conceptdoi macro and equal to the concept_doi of one product.json manuscripts entry."
        },
        "text": {
          "$ref": "#/$defs/bmText"
        }
      }
    },
    "bmQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "case_ids",
        "protocol",
        "runs",
        "metrics",
        "rows",
        "absent",
        "standings",
        "reading",
        "negative_results"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q\\d+$"
        },
        "title": {
          "$ref": "#/$defs/bmText"
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "protocol": {
          "$ref": "#/$defs/bmText"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bmRun"
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bmMetric"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bmRow"
          }
        },
        "absent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bmAbsent"
          }
        },
        "standings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bmStanding"
          }
        },
        "reading": {
          "$ref": "#/$defs/bmText"
        },
        "negative_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bmNegativeResult"
          }
        }
      }
    },
    "bmLeftOut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ladder_id",
        "method",
        "reason",
        "backlog"
      ],
      "properties": {
        "ladder_id": {
          "$ref": "#/$defs/bmLadderId"
        },
        "method": {
          "$ref": "#/$defs/bmText"
        },
        "reason": {
          "$ref": "#/$defs/bmText"
        },
        "backlog": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bmNotBuilt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q\\d+$"
        },
        "title": {
          "$ref": "#/$defs/bmText"
        },
        "reason": {
          "$ref": "#/$defs/bmText"
        }
      }
    }
  }
}
