{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c01/variant.schema.json",
  "title": "C01 variant",
  "description": "Catalog row c01-variant 3.0.0: one C01 (retail PD) variant artifact. The default variant schema: its outputs carry no kind. 3.0.0 adds the reject_inference block (S-6), required and null on every variant but the German twin.",
  "allOf": [
    {"$ref": "../common/variant-envelope.schema.json"},
    {
      "properties": {
        "case_id": {"const": "C01"},
        "outputs": {"$ref": "#/$defs/c01VariantOutputs"}
      },
      "required": ["case_id","outputs"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c01GradeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade","lo","hi","n","d","pd","dr"],
      "properties": {
        "grade": {"type": "string"},
        "lo": {"type": "number"},
        "hi": {"type": "number"},
        "n": {"type": "integer", "minimum": 0},
        "d": {"type": "integer", "minimum": 0},
        "pd": {
          "type": ["number","null"],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "dr": {"type": ["number","null"]}
      }
    },
    "c01GroupStat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n","default_rate","auc","roc"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "default_rate": {"type": "number"},
        "auc": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "roc": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fpr","tpr"],
            "properties": {
              "fpr": {
                "type": "array",
                "items": {"type": "number"}
              },
              "tpr": {
                "type": "array",
                "items": {"type": "number"}
              }
            }
          },
          "description": "The ROC of the champion and of every challenger within the group (51 points)."
        }
      }
    },
    "c01Irb": {
      "description": "What C01's capital view states (CT-212, CT-214).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_class",
        "regimes",
        "by_regime",
        "revolvers_only",
        "six_month_full_payers",
        "lgd_floor_basel3",
        "lgd_floor_source",
        "transactor_source",
        "ead",
        "parity"
      ],
      "properties": {
        "asset_class": {"type": "string"},
        "regimes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "by_regime": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/c01RegimeFacts"}
        },
        "revolvers_only": {"type": "boolean"},
        "six_month_full_payers": {"type": ["integer","null"]},
        "lgd_floor_basel3": {"type": "number"},
        "lgd_floor_source": {"type": "string"},
        "transactor_source": {"type": "string"},
        "ead": {"$ref": "../common/text.schema.json"},
        "parity": {
          "anyOf": [
            {
              "type": "array",
              "items": {"$ref": "#/$defs/c01RetailParityPoint"}
            },
            {"type": "null"}
          ]
        }
      }
    },
    "c01RegimeFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","pd_floor_revolver","pd_floor","scaling","references"],
      "properties": {
        "name": {"type": "string"},
        "pd_floor_revolver": {"type": ["number","null"], "description": "The QRRE revolvers' PD floor (null for other retail)."},
        "pd_floor": {"type": "number"},
        "scaling": {"type": "number"},
        "references": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "c01ReliabilityBin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n","pd","dr","lo","hi"],
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "pd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "dr": {"type": "number"},
        "lo": {"type": "number"},
        "hi": {"type": "number"}
      }
    },
    "c01RetailParityPoint": {
      "description": "One point of the retail risk weight, from riskvalidation, for the live port (CT-215).",
      "type": "object",
      "additionalProperties": false,
      "required": ["regime","asset_class","revolver","pd","lgd","risk_weight"],
      "properties": {
        "regime": {"type": "string"},
        "asset_class": {"type": "string"},
        "revolver": {"type": "boolean"},
        "pd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lgd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_weight": {"type": "number"}
      }
    },
    "c01RungOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grades","reliability","roc","cap","distribution","cutoff","reliability_raw"],
      "properties": {
        "grades": {
          "type": "array",
          "items": {"$ref": "#/$defs/c01GradeRow"}
        },
        "reliability": {
          "type": "array",
          "items": {"$ref": "#/$defs/c01ReliabilityBin"}
        },
        "roc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fpr","tpr"],
          "properties": {
            "fpr": {
              "type": "array",
              "items": {"type": "number"}
            },
            "tpr": {
              "type": "array",
              "items": {"type": "number"}
            }
          }
        },
        "cap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population","defaults","default_rate"],
          "properties": {
            "population": {
              "type": "array",
              "items": {"type": "number"}
            },
            "defaults": {
              "type": "array",
              "items": {"type": "number"}
            },
            "default_rate": {"type": "number"}
          }
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["log10_pd_edges","defaulters","non_defaulters"],
          "properties": {
            "log10_pd_edges": {
              "type": "array",
              "items": {"type": "number"}
            },
            "defaulters": {
              "type": "array",
              "items": {"type": "integer"}
            },
            "non_defaulters": {
              "type": "array",
              "items": {"type": "integer"}
            }
          }
        },
        "cutoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cutoff",
            "approval_rate",
            "bad_rate",
            "pd_ead",
            "ead",
            "capital_per_lgd",
            "capital_per_lgd_transactors"
          ],
          "properties": {
            "cutoff": {
              "type": "array",
              "items": {"type": "number"}
            },
            "approval_rate": {
              "type": "array",
              "items": {"type": "number"}
            },
            "bad_rate": {
              "type": "array",
              "items": {"type": "number"}
            },
            "pd_ead": {
              "type": "array",
              "items": {"type": "number"}
            },
            "ead": {
              "type": "array",
              "items": {"type": "number"}
            },
            "capital_per_lgd": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {"type": "number"}
              }
            },
            "capital_per_lgd_transactors": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {"type": "number"}
                  }
                },
                {"type": "null"}
              ]
            }
          }
        },
        "reliability_raw": {
          "anyOf": [
            {
              "type": "array",
              "items": {"$ref": "#/$defs/c01ReliabilityBin"}
            },
            {"type": "null"}
          ],
          "description": "The same with the six-month full payers as transactors (the cards only; null for the loans)."
        }
      }
    },
    "c01ScoredSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ids",
        "targets",
        "inputs",
        "scorecard_points",
        "scorecard_score",
        "scorecard_pd",
        "ebm_logit"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "targets": {
          "type": "array",
          "items": {"type": "integer"},
          "description": "The observed outcome of each sampled applicant (1 = default)."
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "anyOf": [
                {"type": "number"},
                {"type": "string"}
              ]
            }
          }
        },
        "scorecard_points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "integer"}
          }
        },
        "scorecard_score": {
          "type": "array",
          "items": {"type": "integer"}
        },
        "scorecard_pd": {
          "type": "array",
          "items": {"type": "number"}
        },
        "ebm_logit": {
          "type": "array",
          "items": {"type": "number"}
        }
      }
    },
    "c01RejectStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean",
        "lo",
        "hi"
      ],
      "properties": {
        "mean": {
          "type": "number"
        },
        "lo": {
          "type": "number"
        },
        "hi": {
          "type": "number"
        }
      }
    },
    "c01RejectRung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bias",
        "abs_bias",
        "reduction",
        "beats_share",
        "auc",
        "auc_vs_accepted_only",
        "brier",
        "reps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bias": {
          "$ref": "#/$defs/c01RejectStat",
          "description": "Mean level bias (mean PD minus the observed default rate) on the accept-all population, over the repetitions, with the percentile bootstrap interval of that mean."
        },
        "abs_bias": {
          "type": "number",
          "minimum": 0
        },
        "reduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "lo",
            "hi"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "lo": {
              "type": "number"
            },
            "hi": {
              "type": "number"
            }
          },
          "description": "1 - |mean bias of the rung| / |mean bias of the accepted-only model|, with its paired bootstrap interval; 0 for the accepted-only model itself."
        },
        "beats_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of repetitions in which the rung's absolute bias is below the accepted-only model's."
        },
        "auc": {
          "$ref": "#/$defs/c01RejectStat"
        },
        "auc_vs_accepted_only": {
          "$ref": "#/$defs/c01RejectStat",
          "description": "Paired difference of the AUC on the accept-all population against the accepted-only model."
        },
        "brier": {
          "$ref": "#/$defs/c01RejectStat"
        },
        "reps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bias",
            "auc"
          ],
          "properties": {
            "bias": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "auc": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "description": "The per-repetition level bias and AUC, six decimals, in repetition order."
        }
      }
    },
    "c01RejectInference": {
      "description": "S-6: reject inference on a sample with a known rejected population (the German twin; null elsewhere).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "rungs",
        "regimes",
        "hypotheses"
      ],
      "properties": {
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population",
            "learner",
            "n_rows",
            "n_dev",
            "n_test",
            "reps",
            "accept_share",
            "test_share",
            "weight_floor",
            "bands",
            "min_accepted",
            "prudence",
            "c_inverse_penalty",
            "bootstrap",
            "level",
            "h2_reduction",
            "h3_auc_gain"
          ],
          "properties": {
            "population": {
              "type": "string"
            },
            "learner": {
              "type": "string"
            },
            "n_rows": {
              "type": "integer",
              "minimum": 1
            },
            "n_dev": {
              "type": "integer",
              "minimum": 1
            },
            "n_test": {
              "type": "integer",
              "minimum": 1
            },
            "reps": {
              "type": "integer",
              "minimum": 1
            },
            "accept_share": {
              "type": "number"
            },
            "test_share": {
              "type": "number"
            },
            "weight_floor": {
              "type": "number"
            },
            "bands": {
              "type": "integer",
              "minimum": 1
            },
            "min_accepted": {
              "type": "integer",
              "minimum": 1
            },
            "prudence": {
              "type": "number"
            },
            "c_inverse_penalty": {
              "type": "number"
            },
            "bootstrap": {
              "type": "integer",
              "minimum": 1
            },
            "level": {
              "type": "number"
            },
            "h2_reduction": {
              "type": "number"
            },
            "h3_auc_gain": {
              "type": "number"
            }
          }
        },
        "rungs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "short_title",
              "source",
              "what"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "$ref": "../common/text.schema.json"
              },
              "short_title": {
                "$ref": "../common/text.schema.json"
              },
              "source": {
                "type": "string"
              },
              "what": {
                "$ref": "../common/text.schema.json"
              }
            }
          }
        },
        "regimes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kappa",
              "title",
              "short_title",
              "what",
              "default_rate",
              "rungs"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kappa": {
                "type": "number"
              },
              "title": {
                "$ref": "../common/text.schema.json"
              },
              "short_title": {
                "$ref": "../common/text.schema.json"
              },
              "what": {
                "$ref": "../common/text.schema.json"
              },
              "default_rate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "population",
                  "accepted",
                  "rejected"
                ],
                "properties": {
                  "population": {
                    "type": "number"
                  },
                  "accepted": {
                    "type": "number"
                  },
                  "rejected": {
                    "type": "number"
                  }
                }
              },
              "rungs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/c01RejectRung"
                }
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "holds",
              "value",
              "lo",
              "hi",
              "rung",
              "statement",
              "outcome"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "holds": {
                "type": "boolean"
              },
              "value": {
                "type": "number"
              },
              "lo": {
                "type": "number"
              },
              "hi": {
                "type": "number"
              },
              "rung": {
                "type": "string"
              },
              "statement": {
                "$ref": "../common/text.schema.json"
              },
              "outcome": {
                "$ref": "../common/text.schema.json"
              }
            }
          }
        }
      }
    },
    "c01VariantOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rungs","n","defaults","groups","sample","irb","reject_inference"],
      "properties": {
        "rungs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/c01RungOutputs"}
        },
        "n": {"type": "integer", "minimum": 0},
        "defaults": {"type": "integer", "minimum": 0},
        "groups": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/c01GroupStat"}
        },
        "sample": {
          "anyOf": [
            {"$ref": "#/$defs/c01ScoredSample"},
            {"type": "null"}
          ]
        },
        "irb": {"$ref": "#/$defs/c01Irb"},
        "reject_inference": {
          "description": "S-6, reject inference on a simulated legacy policy: carried by the German twin, null on every other variant.",
          "anyOf": [
            {"$ref": "#/$defs/c01RejectInference"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
