{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c03/models.schema.json",
  "title": "C03 models",
  "description": "Catalog row c03-models 1.0.0: the C03 models artifact (vintage definition, target, training window, test cohorts, PD rungs).",
  "allOf": [
    {
      "$ref": "../common/models-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C03"
        },
        "fit": {
          "$ref": "#/$defs/c03Fit"
        }
      },
      "required": [
        "case_id",
        "fit"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c03Training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_fy",
        "last_fy",
        "cutoff_date",
        "n_loans",
        "n_events",
        "crisis_included",
        "rationale"
      ],
      "properties": {
        "first_fy": {
          "type": "integer",
          "minimum": 1991
        },
        "last_fy": {
          "type": "integer",
          "minimum": 1991
        },
        "cutoff_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "n_loans": {
          "type": "integer",
          "minimum": 0
        },
        "n_events": {
          "type": "integer",
          "minimum": 0
        },
        "crisis_included": {
          "type": "boolean"
        },
        "rationale": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The training window (decision D1): strict out-of-time by approval fiscal year. It holds only approval cohorts whose 5-year charge-off mark falls before the first approval date of the test cohort: last_fy <= cohort.first_fy - 6, and cutoff_date is at most 30 September of cohort.first_fy - 1. The 'trained through the crisis' claim (crisis_included) holds only for a test cohort from FY2011-14 on, whose training outcomes include the crisis-era charge-offs."
    },
    "c03Target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "horizon_months",
        "observed_at_months",
        "censoring",
        "definition"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "horizon_months": {
          "const": 60,
          "description": "Months from approval over which a charge-off counts: the 5-year target."
        },
        "observed_at_months": {
          "const": 60,
          "description": "The target is read for a vintage only at its 5-year mark (60 months after its last approval)."
        },
        "censoring": {
          "type": "string",
          "enum": [
            "exempt-right-censored",
            "excluded"
          ]
        },
        "definition": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The 5-year charge-off target and how loans without an observed outcome (EXEMPT, still active) are handled."
    },
    "c03DataStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_source",
        "files_as_of",
        "fiscal_year_start",
        "notice"
      ],
      "properties": {
        "primary_source": {
          "type": "string"
        },
        "files_as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fiscal_year_start": {
          "type": "string",
          "description": "Month and day the SBA fiscal year starts (10-01)."
        },
        "notice": {
          "$ref": "../common/text.schema.json"
        }
      }
    },
    "c03CohortWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "first_fy",
        "last_fy",
        "training"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "$ref": "../common/text.schema.json"
        },
        "first_fy": {
          "type": "integer",
          "minimum": 1991
        },
        "last_fy": {
          "type": "integer",
          "minimum": 1991
        },
        "training": {
          "$ref": "#/$defs/c03Training"
        }
      },
      "description": "A test cohort with its own training window (decision D1): every variant trains only on approval cohorts whose 5-year mark precedes its first approval date."
    },
    "c03Coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "estimate",
        "std_error"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "estimate": {
          "type": "number"
        },
        "std_error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "c03Rung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rung_id",
        "kind",
        "covariates",
        "coefficients",
        "training_cutoff",
        "engine"
      ],
      "properties": {
        "rung_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "constant",
            "woe-scorecard",
            "penalised-logit",
            "pltr",
            "ebm",
            "monotone-gbm",
            "tabpfn"
          ]
        },
        "covariates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coefficients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c03Coefficient"
          }
        },
        "training_cutoff": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "engine": {
          "type": "string"
        }
      },
      "description": "A PD rung of the existing engine ladder (docs/design/features/c01-retail-pd/design.md rungs P0 to P5), fitted on a training window; training_cutoff is that of the latest cohort window, the earlier windows' cutoffs sit in cohort_windows."
    },
    "c03VintageDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "fiscal_year_start",
        "label"
      ],
      "properties": {
        "basis": {
          "type": "string"
        },
        "fiscal_year_start": {
          "type": "string"
        },
        "label": {
          "$ref": "../common/text.schema.json"
        }
      }
    },
    "c03Fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "vintage_definition",
        "target",
        "cohort_windows",
        "ladder",
        "data_status"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "vintage_definition": {
          "$ref": "#/$defs/c03VintageDefinition"
        },
        "target": {
          "$ref": "#/$defs/c03Target"
        },
        "cohort_windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c03CohortWindow"
          },
          "minItems": 1
        },
        "ladder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c03Rung"
          },
          "minItems": 1
        },
        "data_status": {
          "$ref": "#/$defs/c03DataStatus"
        }
      },
      "description": "C03 models: the vintage definition, the target, the five test cohorts each with its own training window, and the PD rungs."
    }
  }
}
