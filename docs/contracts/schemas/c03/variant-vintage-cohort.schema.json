{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c03/variant-vintage-cohort.schema.json",
  "title": "C03 vintage-cohort variant",
  "description": "Catalog row c03-outputs 4.0.0: one test cohort of approval fiscal years of the SME PD by vintage case (outputs.kind vintage-cohort), on the SBA 7(a) data.",
  "allOf": [
    {
      "$ref": "../common/variant-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C03"
        },
        "outputs": {
          "$ref": "#/$defs/c03Outputs",
          "properties": {
            "kind": {
              "const": "vintage-cohort"
            }
          }
        }
      },
      "required": [
        "case_id",
        "outputs"
      ]
    },
    {
      "properties": {
        "tests": {
          "items": {
            "if": {
              "properties": {
                "light": {
                  "const": "not_evaluated"
                }
              },
              "required": [
                "light"
              ]
            },
            "then": {
              "properties": {
                "statistic": {
                  "type": "null"
                },
                "p_value": {
                  "type": "null"
                },
                "metric": {
                  "type": "null"
                },
                "notes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "tests": {
          "items": {
            "properties": {
              "extras": {
                "properties": {
                  "reference_text": {
                    "$ref": "../common/text.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c03Cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "first_fy",
        "last_fy",
        "approval_fiscal_years"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "$ref": "../common/text.schema.json"
        },
        "first_fy": {
          "type": "integer",
          "minimum": 1991,
          "description": "First approval fiscal year of the test cohort (SBA fiscal years start on 1 October)."
        },
        "last_fy": {
          "type": "integer",
          "minimum": 1991
        },
        "approval_fiscal_years": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1991
          },
          "minItems": 1
        }
      },
      "description": "One test cohort of approval fiscal years (SDD section 5: FY2006-07, 2008-10, 2011-14, 2015-17, 2018-20)."
    },
    "c03Training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_fy",
        "last_fy",
        "cutoff_date",
        "n_loans",
        "n_events",
        "crisis_included",
        "rationale"
      ],
      "properties": {
        "first_fy": {
          "type": "integer",
          "minimum": 1991
        },
        "last_fy": {
          "type": "integer",
          "minimum": 1991
        },
        "cutoff_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "n_loans": {
          "type": "integer",
          "minimum": 0
        },
        "n_events": {
          "type": "integer",
          "minimum": 0
        },
        "crisis_included": {
          "type": "boolean"
        },
        "rationale": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The training window (decision D1): strict out-of-time by approval fiscal year. It holds only approval cohorts whose 5-year charge-off mark falls before the first approval date of the test cohort: last_fy <= cohort.first_fy - 6, and cutoff_date is at most 30 September of cohort.first_fy - 1. The 'trained through the crisis' claim (crisis_included) holds only for a test cohort from FY2011-14 on, whose training outcomes include the crisis-era charge-offs."
    },
    "c03Target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "horizon_months",
        "observed_at_months",
        "censoring",
        "definition"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "horizon_months": {
          "const": 60,
          "description": "Months from approval over which a charge-off counts: the 5-year target."
        },
        "observed_at_months": {
          "const": 60,
          "description": "The target is read for a vintage only at its 5-year mark (60 months after its last approval)."
        },
        "censoring": {
          "type": "string",
          "enum": [
            "exempt-right-censored",
            "excluded"
          ]
        },
        "definition": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The 5-year charge-off target and how loans without an observed outcome (EXEMPT, still active) are handled."
    },
    "c03DataStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_source",
        "files_as_of",
        "fiscal_year_start",
        "notice"
      ],
      "properties": {
        "primary_source": {
          "type": "string"
        },
        "files_as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fiscal_year_start": {
          "type": "string",
          "description": "Month and day the SBA fiscal year starts (10-01)."
        },
        "notice": {
          "$ref": "../common/text.schema.json"
        }
      }
    },
    "c03VintageCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiscal_year",
        "n",
        "gross_approval",
        "months",
        "predicted_cumulative_pd",
        "observed_cumulative_pd",
        "observed_until_month",
        "reason"
      ],
      "properties": {
        "fiscal_year": {
          "type": "integer",
          "minimum": 1991
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "gross_approval": {
          "type": "number",
          "minimum": 0,
          "description": "Total gross approval of the vintage in the `currency` of the outputs."
        },
        "months": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "description": "Months since approval, strictly increasing."
        },
        "predicted_cumulative_pd": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1,
            "description": "An estimate-site PD is open: 0 < pd < 1."
          },
          "minItems": 1
        },
        "observed_cumulative_pd": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "A share or an observed rate in [0, 1]."
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1,
          "description": "Null where the horizon is beyond the observation cutoff."
        },
        "observed_until_month": {
          "type": "integer",
          "minimum": 0,
          "description": "Months from the last approval of the vintage to files_as_of."
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the observed curve stops before the 5-year mark; null when it reaches it."
        }
      },
      "description": "The predicted and the observed cumulative charge-off PD of one approval-year vintage.",
      "oneOf": [
        {
          "properties": {
            "observed_until_month": {
              "type": "integer",
              "minimum": 60
            },
            "reason": {
              "type": "null"
            },
            "observed_cumulative_pd": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "A share or an observed rate in [0, 1]."
              },
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "observed_until_month": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "observed_cumulative_pd": {
              "type": "array",
              "contains": {
                "type": "null"
              },
              "minContains": 1
            }
          }
        }
      ]
    },
    "c03VintageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiscal_year",
        "n",
        "n_resolved",
        "n_exempt_censored",
        "gross_approval",
        "five_year_mark_date",
        "mark_observed",
        "observed_5y_pd",
        "predicted_5y_pd",
        "gap",
        "brier",
        "auc",
        "reason"
      ],
      "properties": {
        "fiscal_year": {
          "type": "integer",
          "minimum": 1991
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "n_resolved": {
          "type": "integer",
          "minimum": 0
        },
        "n_exempt_censored": {
          "type": "integer",
          "minimum": 0
        },
        "gross_approval": {
          "type": "number",
          "minimum": 0
        },
        "five_year_mark_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "mark_observed": {
          "type": "boolean"
        },
        "observed_5y_pd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A share or an observed rate in [0, 1]."
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the vintage has not reached its 5-year mark; the reason says why."
        },
        "predicted_5y_pd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "An estimate-site PD is open: 0 < pd < 1."
        },
        "gap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Observed minus predicted at the 5-year mark; null when unobserved."
        },
        "brier": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "auc": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A share or an observed rate in [0, 1]."
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "One vintage at its 5-year mark. five_year_mark_date is 30 September of fiscal_year + 5; mark_observed is true exactly when it is on or before data_status.files_as_of (a producer check). Observed: the PD, the gap and no reason. Unobserved: no PD, no gap, no brier, no auc, and the reason.",
      "oneOf": [
        {
          "properties": {
            "mark_observed": {
              "const": true
            },
            "observed_5y_pd": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A share or an observed rate in [0, 1]."
            },
            "gap": {
              "type": "number"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "mark_observed": {
              "const": false
            },
            "observed_5y_pd": {
              "type": "null"
            },
            "gap": {
              "type": "null"
            },
            "brier": {
              "type": "null"
            },
            "auc": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "c03VintageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "rows"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c03VintageRow"
          },
          "minItems": 1
        }
      }
    },
    "c03DecileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decile",
        "n",
        "predicted_pd",
        "observed_pd",
        "ci_low",
        "ci_high"
      ],
      "properties": {
        "decile": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "predicted_pd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "An estimate-site PD is open: 0 < pd < 1."
        },
        "observed_pd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A share or an observed rate in [0, 1]."
        },
        "ci_low": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A share or an observed rate in [0, 1]."
        },
        "ci_high": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A share or an observed rate in [0, 1]."
        }
      }
    },
    "c03Calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rung_id",
        "scope",
        "rows"
      ],
      "properties": {
        "rung_id": {
          "type": "string"
        },
        "scope": {
          "$ref": "../common/text.schema.json",
          "description": "The vintages pooled: those whose 5-year mark is observed (bilingual since c03-outputs 2.0.0)."
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c03DecileRow"
          },
          "minItems": 1
        }
      }
    },
    "c03RungResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rung_id",
        "auc",
        "auc_ci_low",
        "auc_ci_high",
        "brier",
        "calibration_gap_5y",
        "reason"
      ],
      "properties": {
        "rung_id": {
          "type": "string"
        },
        "auc": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A share or an observed rate in [0, 1]."
            },
            {
              "type": "null"
            }
          ]
        },
        "auc_ci_low": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A share or an observed rate in [0, 1]."
            },
            {
              "type": "null"
            }
          ]
        },
        "auc_ci_high": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A share or an observed rate in [0, 1]."
            },
            {
              "type": "null"
            }
          ]
        },
        "brier": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "calibration_gap_5y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "c03StabilityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiscal_year",
        "psi",
        "observed_5y_pd"
      ],
      "properties": {
        "fiscal_year": {
          "type": "integer",
          "minimum": 1991
        },
        "psi": {
          "type": "number",
          "minimum": 0
        },
        "observed_5y_pd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A share or an observed rate in [0, 1]."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "c03Stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_mean_5y_pd",
        "psi_note",
        "rows"
      ],
      "properties": {
        "training_mean_5y_pd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A share or an observed rate in [0, 1]."
        },
        "psi_note": {
          "$ref": "../common/text.schema.json"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c03StabilityRow"
          },
          "minItems": 1
        }
      },
      "description": "Population stability of each test vintage against the training window and its observed 5-year rate against the training mean (the crisis contrast)."
    },
    "c03SeqPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "log_e",
        "rejection_month",
        "anytime_p_value",
        "max_log_e"
      ],
      "properties": {
        "log_e": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1,
          "description": "log E at each age (months), null where no loan of the cohort is observed at that age; the monitor rejects at log 20."
        },
        "rejection_month": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "The first age at which the process reached the threshold; null when it never did."
        },
        "anytime_p_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "min(1, 1 / sup E): valid at any stopping time."
        },
        "max_log_e": {
          "type": "number"
        }
      },
      "description": "The e-process of the cohort under one combination of its vintages."
    },
    "c03SeqVintage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiscal_year",
        "n",
        "months_observed",
        "defaults",
        "predicted_defaults",
        "rejection_month",
        "max_log_e",
        "log_e",
        "five_year_light",
        "months_before_the_mark"
      ],
      "properties": {
        "fiscal_year": {
          "type": "integer",
          "minimum": 1991
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "months_observed": {
          "type": "integer",
          "minimum": 0,
          "description": "Months of age observed for the vintage (a multiple of the age step)."
        },
        "defaults": {
          "type": "integer",
          "minimum": 0,
          "description": "Charge-offs in the observed age intervals (whole loans)."
        },
        "predicted_defaults": {
          "type": "number",
          "minimum": 0,
          "description": "The sum over the observed intervals of the vintage's loans times the predicted interval PD."
        },
        "rejection_month": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "The first age at which this vintage's own e-process reached the threshold."
        },
        "max_log_e": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "log_e": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1
        },
        "five_year_light": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "green",
                "amber",
                "red",
                "not_evaluated",
                "error"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The light of the champion's binomial row on this vintage at the 5-year mark; null when the mark is not observed."
        },
        "months_before_the_mark": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "The months between the rejection and the last age; null when the vintage never rejected."
        }
      },
      "description": "One vintage as a grade of the cohort's e-process, set beside the fixed-window reading at the 5-year mark."
    },
    "c03Sequential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "alpha_level",
        "threshold",
        "direction",
        "headline",
        "months",
        "vintages",
        "average",
        "product",
        "reading",
        "limits"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "alpha_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "The size of the monitor."
        },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 1,
          "description": "1 / alpha_level: the value the process must reach to reject."
        },
        "direction": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "two-sided"
          ]
        },
        "headline": {
          "type": "string",
          "enum": [
            "average",
            "product"
          ]
        },
        "months": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "description": "The ages at which the cohort is read."
        },
        "vintages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c03SeqVintage"
          },
          "minItems": 1
        },
        "average": {
          "$ref": "#/$defs/c03SeqPath"
        },
        "product": {
          "$ref": "#/$defs/c03SeqPath"
        },
        "reading": {
          "$ref": "../common/text.schema.json"
        },
        "limits": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "BS-15 (unit D15): the engine's e-process monitor of defaults against the predicted PD, read at every age of the vintages of the cohort instead of once at the 5-year mark. The vintages are the grades, the ages the steps; the average is valid whatever their dependence."
    },
    "c03Outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "currency",
        "cohort",
