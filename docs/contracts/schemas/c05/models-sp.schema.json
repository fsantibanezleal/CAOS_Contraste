{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c05/models-sp.schema.json",
  "title": "C05 S&P models",
  "description": "Catalog row c05-models-sp 2.0.0: the C05 models artifact of the S&P fit (any fit_id but ldp).",
  "allOf": [
    {"$ref": "../common/models-envelope.schema.json"},
    {
      "properties": {
        "case_id": {"const": "C05"},
        "fit": {"$ref": "#/$defs/c05SpFit"}
      },
      "required": ["case_id","fit"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c05SpFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimation_year","targets"],
      "properties": {
        "estimation_year": {"type": "integer"},
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pd","accuracy_ratio"],
          "properties": {
            "pd": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "accuracy_ratio": {"type": "number"}
          }
        }
      }
    }
  }
}
