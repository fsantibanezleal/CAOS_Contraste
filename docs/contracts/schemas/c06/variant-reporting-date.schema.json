{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c06/variant-reporting-date.schema.json",
  "title": "C06 reporting-date variant",
  "description": "Catalog row c06-outputs 1.0.0: one reporting date of the mortgage lifetime PD, staging and ECL case (outputs.kind reporting-date).",
  "allOf": [
    {
      "$ref": "../common/variant-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C06"
        },
        "outputs": {
          "$ref": "#/$defs/c06Outputs",
          "properties": {
            "kind": {
              "const": "reporting-date"
            }
          }
        }
      },
      "required": [
        "case_id",
        "outputs"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c06Outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reporting_date",
        "currency",
        "period_months",
        "horizon",
        "settings",
        "data_status",
        "scenarios",
        "term_structures",
        "account_curves",
        "sicr_points",
        "stage_flows",
        "stage_summary",
        "ecl_by_scenario",
        "weight_grid",
        "non_linearity",
        "waterfall",
        "overlays",
        "reconciliation",
        "lifetime_backtest",
        "rung_comparison",
        "decile_calibration"
      ],
      "properties": {
        "kind": {
          "const": "reporting-date"
        },
        "reporting_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "period_months": {
          "type": "integer",
          "minimum": 1
        },
        "horizon": {
          "$ref": "#/$defs/c06Horizon"
        },
        "settings": {
          "$ref": "#/$defs/c06Settings"
        },
        "data_status": {
          "$ref": "#/$defs/c06DataStatus"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06ScenarioWeight"
          },
          "minItems": 2,
          "description": "At least two probability-weighted scenarios (IFRS 9 5.5.17(a), B5.5.42); weights sum to 1."
        },
        "term_structures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06TermStructure"
          }
        },
        "account_curves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06AccountCurve"
          }
        },
        "sicr_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06SicrPoint"
          }
        },
        "stage_flows": {
          "$ref": "#/$defs/c06StageFlows"
        },
        "stage_summary": {
          "$ref": "#/$defs/c06StageSummary"
        },
        "ecl_by_scenario": {
          "$ref": "#/$defs/c06EclByScenario"
        },
        "weight_grid": {
          "$ref": "#/$defs/c06WeightGrid"
        },
        "non_linearity": {
          "$ref": "#/$defs/c06NonLinearity"
        },
        "waterfall": {
          "$ref": "#/$defs/c06Waterfall"
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06Overlay"
          }
        },
        "reconciliation": {
          "$ref": "#/$defs/c06Reconciliation"
        },
        "lifetime_backtest": {
          "$ref": "#/$defs/c06LifetimeBacktest"
        },
        "rung_comparison": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06RungResult"
          }
        },
        "decile_calibration": {
          "$ref": "#/$defs/c06DecileCalibration"
        }
      },
      "description": "C06 reporting-date outputs (outputs.kind reporting-date): one reporting date of the lifetime PD, staging and ECL run. Money in `currency`; PD open (0, 1); horizons in months. A value the bake may lack is nullable with its reason. Staging parameters have one source, `settings` (the C06 models `staging_policy` repeats it field by field). Money identities of the reconciliation close by one tolerance basis (see `reconciliation`)."
    },
    "c06Horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage1_months",
        "lifetime_cap_months"
      ],
      "properties": {
        "stage1_months": {
          "type": "integer",
          "minimum": 1
        },
        "lifetime_cap_months": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "c06Settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discount_convention",
        "eir_basis",
        "probation_months",
        "low_credit_risk_exemption",
        "sicr"
      ],
      "properties": {
        "discount_convention": {
          "type": "string",
          "enum": [
            "mid-period",
            "end-of-period"
          ]
        },
        "eir_basis": {
          "type": "string",
          "enum": [
            "original",
            "current",
            "credit-adjusted"
          ],
          "description": "The EIR basis of every non-POCI account; POCI accounts always use the credit-adjusted EIR (IFRS 9 5.5.13), whatever this value."
        },
        "probation_months": {
          "type": "integer",
          "minimum": 0
        },
        "low_credit_risk_exemption": {
          "type": "boolean"
        },
        "sicr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dpd_backstop",
            "threefold_ratio",
            "absolute_floor",
            "multiplier_schedule",
            "default_dpd",
            "low_credit_risk_pd"
          ],
          "properties": {
            "dpd_backstop": {
              "type": "integer",
              "minimum": 1
            },
            "threefold_ratio": {
              "type": "number",
              "exclusiveMinimum": 1
            },
            "absolute_floor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "multiplier_schedule": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pd_origination_upper",
                  "multiplier"
                ],
                "properties": {
                  "pd_origination_upper": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "multiplier": {
                    "type": "number",
                    "minimum": 1
                  }
                }
              }
            },
            "default_dpd": {
              "type": "integer",
              "minimum": 1,
              "description": "Days past due at which an account is Stage 3 (dpd >= default_dpd; the 90 dpd presumption of IFRS 9 B5.5.37)."
            },
            "low_credit_risk_pd": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Annualised PD at or below which the quantitative SICR tests are suppressed (5.5.10); null when no exemption is used (then `low_credit_risk_exemption` is false). It never suppresses the dpd backstop, forbearance, watch-list, collective or default triggers."
            }
          },
          "description": "The staging policy record (engine StagingPolicy). Only the 30 dpd and 90 dpd presumptions are IFRS 9; the threefold ratio is an EBA supervisory expectation; the rest are Contraste policy parameters."
        }
      }
    },
    "c06DataStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_source",
        "freddie_mac_available",
        "freddie_mac_reason",
        "notice"
      ],
      "properties": {
        "primary_source": {
          "type": "string",
          "enum": [
            "sba-7a",
            "freddie-mac"
          ]
        },
        "freddie_mac_available": {
          "type": "boolean"
        },
        "freddie_mac_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notice": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The data this document stands on. A variant without Freddie Mac data says so and why; nothing is invented."
    },
    "c06ScenarioWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "weight",
        "z_mean"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "$ref": "../common/text.schema.json"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "z_mean": {
          "type": "number"
        }
      }
    },
    "c06TermStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "segment_id",
        "months",
        "hazard",
        "marginal_pd",
        "cumulative_pd"
      ],
      "properties": {
        "scenario_id": {
          "type": "string"
        },
        "segment_id": {
          "type": "string"
        },
        "months": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "hazard": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        },
        "marginal_pd": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        },
        "cumulative_pd": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        }
      },
      "description": "h(t), q(t) = S(t-1) h(t) and F(t) = sum q, per scenario ('weighted' for the probability-weighted curve) and segment; the arrays are aligned with months and F is strictly increasing."
    },
    "c06AccountCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "segment_id",
        "stage",
        "months",
        "origination_cumulative_pd",
        "current_cumulative_pd"
      ],
      "properties": {
        "account_id": {
          "type": "string"
        },
        "segment_id": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "enum": [
            "stage1",
            "stage2",
            "stage3",
            "poci"
          ]
        },
        "months": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "origination_cumulative_pd": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        },
        "current_cumulative_pd": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        }
      },
      "description": "The SICR view's pair of curves for a sampled account: the origination forward curve against the current one over the same remaining window."
    },
    "c06SicrPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "segment_id",
        "stage",
        "pd_origination_annualised",
        "pd_current_annualised",
        "trigger"
      ],
      "properties": {
        "account_id": {
          "type": "string"
        },
        "segment_id": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "enum": [
            "stage1",
            "stage2",
            "stage3",
            "poci"
          ]
        },
        "pd_origination_annualised": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "pd_current_annualised": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "trigger": {
          "type": "string",
          "enum": [
            "none",
            "relative-absolute",
            "threefold",
            "dpd-backstop",
            "forbearance",
            "watch-list",
            "default",
            "collective",
            "cure-probation"
          ]
        }
      }
    },
    "c06StageFlows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_date",
        "to_date",
        "currency",
        "flows"
      ],
      "properties": {
        "from_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "accounts",
              "gross_carrying_amount"
            ],
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "stage1",
                  "stage2",
                  "stage3",
                  "poci",
                  "new",
                  "derecognised",
                  "written-off"
                ]
              },
              "target": {
                "type": "string",
                "enum": [
                  "stage1",
                  "stage2",
                  "stage3",
                  "poci",
                  "new",
                  "derecognised",
                  "written-off"
                ]
              },
              "accounts": {
                "type": "integer",
                "minimum": 0
              },
              "gross_carrying_amount": {
                "type": "number"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "source": {
                      "const": "poci"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "properties": {
                    "target": {
                      "enum": [
                        "poci",
                        "derecognised",
                        "written-off"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "description": "A POCI account stays POCI for its life: a flow out of poci ends in derecognised or written-off."
        }
      }
    },
    "c06StageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "rows"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "accounts",
              "gross_carrying_amount",
              "ecl",
              "coverage"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "stage1",
                  "stage2",
                  "stage3",
                  "poci"
                ]
              },
              "accounts": {
                "type": "integer",
                "minimum": 0
              },
              "gross_carrying_amount": {
                "type": "number"
              },
              "ecl": {
                "type": "number"
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    },
    "c06EclByScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "rows"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_id",
              "stage",
              "ecl"
            ],
            "properties": {
              "scenario_id": {
                "type": "string"
              },
              "stage": {
                "type": "string",
                "enum": [
                  "stage1",
                  "stage2",
                  "stage3",
                  "poci"
                ]
              },
              "ecl": {
                "type": "number"
              }
            }
          }
        }
      },
      "description": "Per-scenario ECL by stage at 100 per cent weight, model ECL without overlays. Staging is frozen: it is computed once at the weighted conditions and applied to every scenario row, so the weighted ECL equals the sum of weight times scenario ECL."
    },
    "c06WeightGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "scenario_ids",
        "points"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "scenario_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "weights",
              "ecl_recomputed",
              "ecl_frozen",
              "stage2_ratio_recomputed",
              "stage2_ratio_frozen"
            ],
            "properties": {
              "weights": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "ecl_recomputed": {
                "type": "number"
              },
              "ecl_frozen": {
                "type": "number"
              },
              "stage2_ratio_recomputed": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "stage2_ratio_frozen": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      },
      "description": "The scenario-weight simplex: ECL and the Stage 2 ratio with staging recomputed against staging frozen; each weights vector is aligned with scenario_ids and sums to 1."
    },
    "c06NonLinearity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "parameters",
        "mean_z",
        "pd_weighted",
        "pd_at_mean_z",
        "ecl_weighted",
        "ecl_at_mean_path",
        "index",
        "z_curve",
        "scenario_points"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pd_ttc",
            "rho"
          ],
          "properties": {
            "pd_ttc": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "rho": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        "mean_z": {
          "type": "number"
        },
        "pd_weighted": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "pd_at_mean_z": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "ecl_weighted": {
          "type": "number"
        },
        "ecl_at_mean_path": {
          "type": "number"
        },
        "index": {
          "type": "number"
        },
        "z_curve": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "z",
              "pd_pit"
            ],
            "properties": {
              "z": {
                "type": "number"
              },
              "pd_pit": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        },
        "scenario_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_id",
              "z",
              "weight",
              "pd_pit"
            ],
            "properties": {
              "scenario_id": {
                "type": "string"
              },
              "z": {
                "type": "number"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "pd_pit": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              }
            }
          }
        }
      },
      "description": "The non-linearity panel: PD_PIT(z), the weighted PD against the PD at the weighted-average factor, and NL = ECL_weighted / ECL(mean path) - 1."
    },
    "c06Waterfall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "lines"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "label",
              "amount",
              "stage",
              "overlay_id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "opening",
                  "originations",
                  "transfer-1-2",
                  "transfer-2-3",
                  "transfer-2-1",
                  "transfer-3-2",
                  "remeasurement",
                  "macro-update",
                  "overlay",
                  "write-off",
                  "derecognition",
                  "unwinding",
                  "closing"
                ]
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "amount": {
                "type": "number"
              },
              "stage": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "stage1",
                      "stage2",
                      "stage3",
                      "poci"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "overlay_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Opening to closing allowance. A positive amount raises the allowance and a negative amount lowers it; the opening line is the sum of the stage openings, every movement line is the sum over the stages of the reconciliation movements with the same `line_id`, and the closing line is the sum of the stage closings. Every overlay is its own line (kind overlay, overlay_id set, id `overlay-<overlay id>`), never merged into a model line."
    },
    "c06Overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "currency",
        "rationale",
        "method",
        "target",
        "segment_id",
        "stage",
        "amount",
        "staging_effect",
        "review_date"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "rationale": {
          "$ref": "../common/text.schema.json"
        },
        "method": {
          "type": "string",
          "enum": [
            "simulation",
            "scenario",
            "expert"
          ]
        },
        "target": {
          "type": "string",
          "enum": [
            "pd",
            "lgd",
            "ead",
            "staging-share"
          ]
        },
        "segment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "stage1",
                "stage2",
                "stage3",
                "poci"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "The stage whose allowance closing carries the overlay; null is portfolio level and is carried in the stage1 closing (a convention of the engine contract)."
        },
        "amount": {
          "type": "number"
        },
        "staging_effect": {
          "type": "string",
          "enum": [
            "none",
            "transfers-to-stage2"
          ]
        },
        "review_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "c06Reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "tolerance",
        "allowance",
        "gross_carrying_amount"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "tolerance": {
          "const": 1e-06,
          "description": "Relative: every identity closes when its absolute difference is at most tolerance * max(1, G), G being the total gross carrying amount of this document (the sum of the absolute closing amounts of `gross_carrying_amount`), in `currency`."
        },
        "allowance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06AllowanceRollForwardRow"
          }
        },
        "gross_carrying_amount": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06GcaRollForwardRow"
          }
        }
      },
      "description": "IFRS 7 35H (allowance) and 35I (gross carrying amount) roll-forwards by stage; opening plus movements equals closing and residual is within the tolerance basis max(1, G) * tolerance (G the total gross carrying amount of the document). Each allowance `line_id` is a waterfall line id; each stage allowance closing equals the stage ECL plus the overlays carried in that stage."
    },
    "c06LifetimeBacktest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows"
      ],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origination_cohort",
              "months",
              "estimator",
              "predicted_cumulative_pd",
              "observed_cumulative_pd",
              "gap",
              "brier",
              "reason"
            ],
            "properties": {
              "origination_cohort": {
                "type": "string",
                "description": "The origination cohort of the row (for example `2018`), or `all` for the pooled originations."
              },
              "months": {
                "type": "integer",
                "minimum": 1
              },
              "estimator": {
                "type": "string",
                "enum": [
                  "kaplan-meier",
                  "aalen-johansen"
                ],
                "description": "Aalen-Johansen cumulative incidence when prepayment competes, Kaplan-Meier otherwise."
              },
              "predicted_cumulative_pd": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "observed_cumulative_pd": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "gap": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "brier": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Observed against predicted cumulative default by origination cohort and horizon (Aalen-Johansen when prepayment competes, Kaplan-Meier otherwise); a horizon not yet observed is null with its reason."
    },
    "c06RungResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rung_id",
        "c_index",
        "integrated_brier",
        "calibration_gap_12m",
        "reason"
      ],
      "properties": {
        "rung_id": {
          "type": "string"
        },
        "c_index": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "integrated_brier": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "calibration_gap_12m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "c06AllowanceMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "amount"
      ],
      "properties": {
        "line_id": {
          "type": "string",
          "description": "Equals the `id` of a `waterfall.lines[]` line (the model lines and `overlay-<overlay id>`), so the waterfall opens into the 35H table."
        },
        "amount": {
          "type": "number",
          "description": "Signed; a positive amount raises the allowance."
        }
      }
    },
    "c06GcaMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_id",
        "amount"
      ],
      "properties": {
        "line_id": {
          "type": "string",
          "enum": [
            "originations",
            "transfer-1-2",
            "transfer-2-3",
            "transfer-2-1",
            "transfer-3-2",
            "repayments",
            "write-off",
            "derecognition",
            "other"
          ]
        },
        "amount": {
          "type": "number",
          "description": "Signed; a positive amount raises the gross carrying amount."
        }
      }
    },
    "c06AllowanceRollForwardRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "opening",
        "movements",
        "closing",
        "residual"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "stage1",
            "stage2",
            "stage3",
            "poci"
          ]
        },
        "opening": {
          "type": "number"
        },
        "movements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06AllowanceMovement"
          }
        },
        "closing": {
          "type": "number"
        },
        "residual": {
          "type": "number",
          "description": "closing - (opening + sum of movements) itself (a document may store it rounded to 1e-9); closure is judged against the reconciliation tolerance basis."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "stage1",
                  "stage2",
                  "stage3"
                ]
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "opening": {
                "minimum": 0
              },
              "closing": {
                "minimum": 0
              }
            }
          }
        }
      ],
      "description": "Only a POCI allowance may be negative (IFRS 9 5.5.14); stage1 to stage3 openings and closings are not."
    },
    "c06GcaRollForwardRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "opening",
        "movements",
        "closing",
        "residual"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "stage1",
            "stage2",
            "stage3",
            "poci"
          ]
        },
        "opening": {
          "type": "number"
        },
        "movements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c06GcaMovement"
          }
        },
        "closing": {
          "type": "number"
        },
        "residual": {
          "type": "number",
          "description": "closing - (opening + sum of movements) itself (a document may store it rounded to 1e-9); closure is judged against the reconciliation tolerance basis."
        }
      }
    },
    "c06DecileCalibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rung_id",
        "rows"
      ],
      "properties": {
        "rung_id": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origination_cohort",
              "months",
              "decile",
              "n",
              "estimator",
              "predicted_cumulative_pd",
              "observed_cumulative_pd",
              "reason"
            ],
            "properties": {
              "origination_cohort": {
                "type": "string"
              },
              "months": {
                "type": "integer",
                "enum": [
                  12,
                  24,
                  36
                ]
              },
              "decile": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "n": {
                "type": "integer",
                "minimum": 0
              },
              "estimator": {
                "type": "string",
                "enum": [
                  "kaplan-meier",
                  "aalen-johansen"
                ]
              },
              "predicted_cumulative_pd": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "observed_cumulative_pd": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "description": "Calibration at 12, 24 and 36 months per predicted-risk decile against the observed cumulative incidence (SDD row Lifetime PD rungs); an unobserved cell is null with its reason."
    }
  }
}
