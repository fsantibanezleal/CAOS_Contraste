{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c07/models.schema.json",
  "title": "C07 models",
  "description": "Catalog row c07-models 1.0.0: the C07 models artifact with the synthetic bank calibration and the transcribed regime tables.",
  "allOf": [
    {
      "$ref": "../common/models-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C07"
        },
        "fit": {
          "$ref": "#/$defs/c07Fit"
        }
      },
      "required": [
        "case_id",
        "fit"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c07Fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "bank",
        "calibration_targets",
        "segments",
        "b1_tables",
        "b1_default_categories",
        "ifrs9",
        "bde",
        "scenarios"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "bank": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "synthetic",
            "notice",
            "seed",
            "calibration_source"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "synthetic": {
              "const": true
            },
            "notice": {
              "$ref": "../common/text.schema.json"
            },
            "seed": {
              "type": "integer"
            },
            "calibration_source": {
              "type": "string"
            }
          }
        },
        "calibration_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "unit",
              "target",
              "achieved",
              "source",
              "as_of"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "target": {
                "type": "number"
              },
              "achieved": {
                "type": "number"
              },
              "source": {
                "type": "string"
              },
              "as_of": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "accounts",
              "gross_exposure",
              "b1_portfolio",
              "bde_segment"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "accounts": {
                "type": "integer",
                "minimum": 0
              },
              "gross_exposure": {
                "type": "number"
              },
              "b1_portfolio": {
                "type": "string",
                "enum": [
                  "residential-mortgage",
                  "consumer",
                  "commercial-group",
                  "commercial-individual"
                ]
              },
              "bde_segment": {
                "type": "string"
              }
            }
          }
        },
        "b1_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c07B1Table"
          }
        },
        "b1_default_categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "tpe_upper",
              "provision_rate"
            ],
            "properties": {
              "category": {
                "type": "string"
              },
              "tpe_upper": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "provision_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "ifrs9": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pd_ladder_rung",
            "discount_convention",
            "segments"
          ],
          "properties": {
            "pd_ladder_rung": {
              "type": "string"
            },
            "discount_convention": {
              "type": "string",
              "enum": [
                "mid-period",
                "end-of-period"
              ]
            },
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "segment_id",
                  "pd_ttc",
                  "rho",
                  "lgd"
                ],
                "properties": {
                  "segment_id": {
                    "type": "string"
                  },
                  "pd_ttc": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "rho": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1
                  },
                  "lgd": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "bde": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal_coverage",
            "doubtful_bucket_labels",
            "doubtful_coverage"
          ],
          "properties": {
            "normal_coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "segment",
                  "normal",
                  "special_watch"
                ],
                "properties": {
                  "segment": {
                    "type": "string"
                  },
                  "normal": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "special_watch": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "doubtful_bucket_labels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "doubtful_coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "segment",
                  "by_bucket"
                ],
                "properties": {
                  "segment": {
                    "type": "string"
                  },
                  "by_bucket": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "shocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "base",
                  "recession",
                  "consumer-arrears-shock",
                  "house-price-fall",
                  "uf-inflation-spike",
                  "combined-severe"
                ]
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "shocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "driver",
                    "unit",
                    "value"
                  ],
                  "properties": {
                    "driver": {
                      "type": "string"
                    },
                    "unit": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "C07 fit: the synthetic Banco Andino calibration, the transcribed B-1 tables with their cells, the IFRS 9 parameters, the BdE Annex 9 coverage and the six scenario definitions."
    },
    "c07B1Table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_id",
        "portfolio",
        "source",
        "cells"
      ],
      "properties": {
        "table_id": {
          "type": "string"
        },
        "portfolio": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row",
              "column",
              "pi",
              "pdi",
              "pe"
            ],
            "properties": {
              "row": {
                "type": "string"
              },
              "column": {
                "type": "string"
              },
              "pi": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "pdi": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pe": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "description": "A transcribed CMF CNCB B-1 table; PI, PDI and PE are decimals (0.010916 is 1.0916 per cent) and, where both are set, PE = PI x PDI to the table's rounding. Closed at 0 and 1 on purpose: the default column is PI = 1 and the tables are statutory parameters, not estimates."
    }
  }
}
