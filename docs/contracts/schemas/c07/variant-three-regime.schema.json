{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c07/variant-three-regime.schema.json",
  "title": "C07 three-regime variant",
  "description": "Catalog row c07-outputs 1.0.0: the Chile provisions trilogy for one scenario variant (outputs.kind three-regime).",
  "allOf": [
    {
      "$ref": "../common/variant-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C07"
        },
        "outputs": {
          "$ref": "#/$defs/c07Outputs",
          "properties": {
            "kind": {
              "const": "three-regime"
            }
          }
        }
      },
      "required": [
        "case_id",
        "outputs"
      ]
    },
    {
      "properties": {
        "tests": {
          "items": {
            "properties": {
              "extras": {
                "properties": {
                  "reference_text": {
                    "$ref": "../common/text.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c07Outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scenario_id",
        "currency",
        "synthetic",
        "notice",
        "scenario",
        "portfolio",
        "regimes",
        "comparison",
        "gap_bridge",
        "b1_detail",
        "ifrs9_detail",
        "bde_detail",
        "delta_vs_base"
      ],
      "properties": {
        "kind": {
          "const": "three-regime"
        },
        "scenario_id": {
          "type": "string",
          "enum": [
            "base",
            "recession",
            "consumer-arrears-shock",
            "house-price-fall",
            "uf-inflation-spike",
            "combined-severe"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "synthetic": {
          "const": true
        },
        "notice": {
          "$ref": "../common/text.schema.json",
          "description": "Must say that the data are synthetic and that the IFRS 9 column is a comparison measure, not the provision Chilean banks book on loans (CMF B-1)."
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "shocks"
          ],
          "properties": {
            "description": {
              "$ref": "../common/text.schema.json"
            },
            "shocks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "driver",
                  "unit",
                  "value"
                ],
                "properties": {
                  "driver": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "portfolio": {
          "$ref": "#/$defs/c07Portfolio"
        },
        "regimes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": false,
          "prefixItems": [
            {
              "$ref": "#/$defs/c07Regime",
              "properties": {
                "regime": {
                  "const": "cmf-b1"
                },
                "status": {
                  "const": "statutory-chile-loans"
                }
              }
            },
            {
              "$ref": "#/$defs/c07Regime",
              "properties": {
                "regime": {
                  "const": "ifrs9"
                },
                "status": {
                  "const": "comparison-measure"
                }
              }
            },
            {
              "$ref": "#/$defs/c07Regime",
              "properties": {
                "regime": {
                  "const": "bde-annex9"
                },
                "status": {
                  "const": "spanish-gaap-alternative-solutions"
                }
              }
            }
          ],
          "description": "Exactly the three regimes in this order."
        },
        "comparison": {
          "$ref": "#/$defs/c07Comparison"
        },
        "gap_bridge": {
          "$ref": "#/$defs/c07GapBridge"
        },
        "b1_detail": {
          "$ref": "#/$defs/c07B1Detail"
        },
        "ifrs9_detail": {
          "$ref": "#/$defs/c07Ifrs9Detail"
        },
        "bde_detail": {
          "$ref": "#/$defs/c07BdeDetail"
        },
        "delta_vs_base": {
          "anyOf": [
            {
              "$ref": "#/$defs/c07DeltaVsBase"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for the base scenario, the deltas against the base scenario for every other one."
        }
      },
      "description": "C07 three-regime comparison (outputs.kind three-regime): the same synthetic portfolio of Banco Andino under CMF B-1, IFRS 9 and BdE Annex 9 for one scenario variant. CMF B-1 is the statutory provision Chilean banks book on loans (IFRS 9 5.5 is carved out for loans in Chile); the IFRS 9 column is a comparison measure, not the Chilean statutory provision; BdE Annex 9 is the Spanish GAAP alternative solution, aligned with IFRS 9. Synthetic, never a statement about a bank. Every currency of the document is the same.",
      "allOf": [
        {
          "if": {
            "properties": {
              "scenario_id": {
                "const": "base"
              }
            },
            "required": [
              "scenario_id"
            ]
          },
          "then": {
            "properties": {
              "delta_vs_base": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "delta_vs_base": {
                "$ref": "#/$defs/c07DeltaVsBase"
              }
            }
          }
        }
      ]
    },
    "c07Portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "segments"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "label",
              "accounts",
              "gross_exposure"
            ],
            "properties": {
              "segment_id": {
                "type": "string"
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "accounts": {
                "type": "integer",
                "minimum": 0
              },
              "gross_exposure": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "c07Regime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "label",
        "currency",
        "total_provision",
        "coverage_rate",
        "by_segment",
        "by_category",
        "status",
        "unallocated_lines"
      ],
      "properties": {
        "regime": {
          "type": "string",
          "enum": [
            "cmf-b1",
            "ifrs9",
            "bde-annex9"
          ]
        },
        "label": {
          "$ref": "../common/text.schema.json"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "total_provision": {
          "type": "number",
          "description": "The comparable total: the sum of by_segment provisions plus the unallocated lines. cmf-b1: the statutory group-applied and individual provisions plus the minimum top-up (a line `minimum-top-up`); the additional provisions are outside this total (b1_detail.additional_provisions, booked_total). ifrs9: the probability-weighted model ECL plus the overlays (lines of kind overlay). bde-annex9: no unallocated line."
        },
        "coverage_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "total_provision divided by the sum of portfolio.gross_exposure over all segments."
        },
        "by_segment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "provision",
              "coverage_rate"
            ],
            "properties": {
              "segment_id": {
                "type": "string"
              },
              "provision": {
                "type": "number"
              },
              "coverage_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "provision divided by portfolio.gross_exposure of the segment."
              }
            }
          },
          "description": "Segment provisions of the model only: for ifrs9 the model ECL excluding overlays; for cmf-b1 the group-applied and individual provisions excluding the minimum top-up."
        },
        "by_category": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category_id",
              "label",
              "exposure",
              "provision"
            ],
            "properties": {
              "category_id": {
                "type": "string"
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "exposure": {
                "type": "number"
              },
              "provision": {
                "type": "number"
              }
            }
          },
          "description": "Model provisions by category, excluding the unallocated lines."
        },
        "status": {
          "type": "string",
          "enum": [
            "statutory-chile-loans",
            "comparison-measure",
            "spanish-gaap-alternative-solutions"
          ],
          "description": "cmf-b1: statutory for Chilean loans; ifrs9: comparison measure, not the Chilean statutory provision; bde-annex9: Spanish GAAP alternative solutions, IFRS 9 aligned."
        },
        "unallocated_lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "label",
              "amount"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "minimum-top-up",
                  "overlay"
                ]
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "amount": {
                "type": "number"
              }
            }
          },
          "description": "Provision components in the total that no segment carries: the B-1 minimum top-up and the IFRS 9 overlays, each its own line."
        }
      }
    },
    "c07Comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "rows",
        "unallocated"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "cmf_b1_provision",
              "ifrs9_provision",
              "bde_annex9_provision",
              "gap_ifrs9_minus_b1",
              "gap_bde_minus_b1"
            ],
            "properties": {
              "segment_id": {
                "type": "string"
              },
              "cmf_b1_provision": {
                "type": "number"
              },
              "ifrs9_provision": {
                "type": "number",
                "description": "Model ECL excluding overlays."
              },
              "bde_annex9_provision": {
                "type": "number"
              },
              "gap_ifrs9_minus_b1": {
                "type": "number"
              },
              "gap_bde_minus_b1": {
                "type": "number"
              }
            }
          },
          "description": "Segment provisions of the model only (by_segment); the unallocated lines are in `unallocated`."
        },
        "unallocated": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cmf_b1_provision",
            "ifrs9_provision",
            "bde_annex9_provision",
            "gap_ifrs9_minus_b1",
            "gap_bde_minus_b1"
          ],
          "properties": {
            "cmf_b1_provision": {
              "type": "number"
            },
            "ifrs9_provision": {
              "type": "number"
            },
            "bde_annex9_provision": {
              "type": "number"
            },
            "gap_ifrs9_minus_b1": {
              "type": "number"
            },
            "gap_bde_minus_b1": {
              "type": "number"
            }
          },
          "description": "The sums of the unallocated lines of each regime; rows plus unallocated equal the regime totals."
        }
      }
    },
    "c07GapBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "from_regime",
        "to_regime",
        "steps"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "from_regime": {
          "const": "cmf-b1"
        },
        "to_regime": {
          "const": "ifrs9"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "amount"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "amount": {
                "type": "number"
              }
            }
          }
        }
      },
      "description": "The gap from the CMF B-1 comparable total to the IFRS 9 total (both as defined on `total_provision`) as exhaustive steps whose amounts sum to the gap exactly (an unexplained step is its own line). B-1 additional provisions are outside both totals and are not a step; the B-1 minimum top-up and the IFRS 9 overlays are."
    },
    "c07B1Detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "minimum_check",
        "group_max_rule",
        "additional_provisions",
        "individual",
        "booked_total"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "minimum_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_rate",
            "normal_portfolio_exposure",
            "normal_portfolio_provision_before_minimum",
            "minimum_amount",
            "binding",
            "top_up"
          ],
          "properties": {
            "minimum_rate": {
              "const": 0.005
            },
            "normal_portfolio_exposure": {
              "type": "number"
            },
            "normal_portfolio_provision_before_minimum": {
              "type": "number"
            },
            "minimum_amount": {
              "type": "number"
            },
            "binding": {
              "type": "boolean"
            },
            "top_up": {
              "type": "number"
            }
          },
          "description": "The 0.50 per cent minimum on the individually assessed normal portfolio (categories A1 to A6), loans plus contingent credits; top_up is carried in regimes[cmf-b1] as the line minimum-top-up."
        },
        "group_max_rule": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segment_id",
              "standard",
              "internal",
              "applied",
              "method",
              "internal_reason"
            ],
            "properties": {
              "segment_id": {
                "type": "string"
              },
              "standard": {
                "type": "number"
              },
              "internal": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The internal-method provision; null when the bank has no internal method (then internal_reason is set and method is standard)."
              },
              "applied": {
                "type": "number"
              },
              "method": {
                "type": "string",
                "enum": [
                  "standard",
                  "internal",
                  "max"
                ]
              },
              "internal_reason": {
                "anyOf": [
                  {
                    "$ref": "../common/text.schema.json"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "internal": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "internal"
                  ]
                },
                "then": {
                  "properties": {
                    "internal_reason": {
                      "$ref": "../common/text.schema.json"
                    },
                    "method": {
                      "const": "standard"
                    }
                  }
                }
              }
            ]
          }
        },
        "additional_provisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "rationale",
            "policy_min",
            "policy_max"
          ],
          "properties": {
            "amount": {
              "type": "number"
            },
            "rationale": {
              "$ref": "../common/text.schema.json"
            },
            "policy_min": {
              "type": "number"
            },
            "policy_max": {
              "type": "number"
            }
          },
          "description": "Counter-cyclical general provisions (B-1 N 9): their own line, outside the comparable total and never per segment."
        },
        "individual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normal_substandard_provision",
            "default_provision"
          ],
          "properties": {
            "normal_substandard_provision": {
              "type": "number"
            },
            "default_provision": {
              "type": "number"
            }
          }
        },
        "booked_total": {
          "type": "number",
          "description": "What the bank books under B-1: the comparable total plus the additional provisions."
        }
      }
    },
    "c07Ifrs9Detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "stage_summary",
        "overlays_total",
        "measure",
        "weighted_components",
        "overlays"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "stage_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "accounts",
              "gross_carrying_amount",
              "ecl",
              "coverage"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "stage1",
                  "stage2",
                  "stage3",
                  "poci"
                ]
              },
              "accounts": {
                "type": "integer",
                "minimum": 0
              },
              "gross_carrying_amount": {
                "type": "number"
              },
              "ecl": {
                "type": "number"
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "description": "Model ECL excluding overlays, by stage."
        },
        "overlays_total": {
          "type": "number",
          "description": "Sum of overlays[].amount; regimes[ifrs9].total_provision = model ECL + overlays_total."
        },
        "measure": {
          "const": "probability-weighted-ecl"
        },
        "weighted_components": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenario_id",
              "weight",
              "z",
              "single_scenario_ecl"
            ],
            "properties": {
              "scenario_id": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "z": {
                "type": "number",
                "description": "The systematic factor of the component: its weighting-scenario offset plus the variant shift."
              },
              "single_scenario_ecl": {
                "type": "number",
                "description": "A component of the weighted measure at 100 per cent weight; a sensitivity, never the IFRS 9 measure."
              }
            }
          },
          "description": "At least two scenarios whose weights sum to 1; the model ECL is the sum of weight times single_scenario_ecl (5.5.17(a), B5.5.42)."
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "segment_id",
              "stage",
              "amount"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "$ref": "../common/text.schema.json"
              },
              "segment_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stage": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "stage1",
                      "stage2",
                      "stage3",
                      "poci"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "amount": {
                "type": "number"
              }
            }
          },
          "description": "Each overlay is its own line, also an unallocated line of regimes[ifrs9]; never merged into by_segment or stage_summary."
        }
      },
      "description": "The IFRS 9 regime of a scenario variant is a probability-weighted ECL over at least two scenarios, with the variant applied as a shift of current conditions (5.5.17(a), B5.5.42). A 100 per cent single-scenario ECL is never an IFRS 9 measure: it appears only as a weighted component or a sensitivity. The stage summary and the segment provisions carry the model ECL excluding overlays; overlays are their own lines."
    },
    "c07BdeDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "categories",
        "method"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "mapped_stage",
              "exposure",
              "provision",
              "coverage_rate"
            ],
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "normal",
                  "normal-special-watch",
                  "doubtful",
                  "written-off"
                ]
              },
              "mapped_stage": {
                "type": "string",
                "enum": [
                  "stage1",
                  "stage2",
                  "stage3",
                  "written-off"
                ]
              },
              "exposure": {
                "type": "number"
              },
              "provision": {
                "type": "number"
              },
              "coverage_rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "provision divided by the exposure of the category."
              }
            }
          }
        },
        "method": {
          "type": "string",
          "enum": [
            "alternative-solutions",
            "internal-methodology"
          ]
        }
      }
    },
    "c07DeltaVsBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "cmf_b1_delta",
        "ifrs9_delta",
        "bde_annex9_delta"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "cmf_b1_delta": {
