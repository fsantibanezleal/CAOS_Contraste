{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c08/models.schema.json",
  "title": "C08 models",
  "description": "Catalog row c08-models 1.0.0: the C08 models artifact (LGD proxy and bias, cohorts, rungs, downturn specification, floor cells).",
  "allOf": [
    {
      "$ref": "../common/models-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C08"
        },
        "fit": {
          "$ref": "#/$defs/c08Fit"
        }
      },
      "required": [
        "case_id",
        "fit"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c08Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "es": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "c08Cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "first_year",
        "last_year"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "$ref": "../common/text.schema.json"
        },
        "first_year": {
          "type": "integer",
          "minimum": 1990
        },
        "last_year": {
          "type": "integer",
          "minimum": 1990
        }
      },
      "description": "One default cohort by default year (SDD section 5: 2003-06, 2007-08, 2009-10, 2011-13, 2014-19, 2020-23)."
    },
    "c08LgdProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "formula",
        "source_field",
        "exposure_field",
        "recovery_cash_flows_available",
        "bias_direction",
        "bias_statement"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/c08Text"
        },
        "formula": {
          "type": "string"
        },
        "source_field": {
          "type": "string",
          "description": "The SBA 7(a) field the numerator reads (GrossChargeOffAmount)."
        },
        "exposure_field": {
          "type": "string"
        },
        "recovery_cash_flows_available": {
          "type": "boolean"
        },
        "bias_direction": {
          "type": "string",
          "enum": [
            "upward",
            "downward",
            "unknown"
          ]
        },
        "bias_statement": {
          "$ref": "#/$defs/c08Text"
        }
      },
      "description": "The LGD proxy of the SBA charge-off twin and its bias, required in every C08 document: the file has no recovery cash flows, so the proxy is the gross charge-off over the exposure at charge-off, not a workout LGD (dossier 08 A.6)."
    },
    "c08DataStatus": {
      "description": "Freddie Mac is a nullable slot: while the owner's account does not exist it is unavailable and the reason is stated; no number stands in for it.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_source",
            "freddie_mac_available",
            "freddie_mac_reason",
            "notice"
          ],
          "properties": {
            "primary_source": {
              "type": "string"
            },
            "freddie_mac_available": {
              "const": false
            },
            "freddie_mac_reason": {
              "type": "string",
              "minLength": 1
            },
            "notice": {
              "$ref": "../common/text.schema.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "primary_source",
            "freddie_mac_available",
            "freddie_mac_reason",
            "notice"
          ],
          "properties": {
            "primary_source": {
              "type": "string"
            },
            "freddie_mac_available": {
              "const": true
            },
            "freddie_mac_reason": {
              "type": "null"
            },
            "notice": {
              "$ref": "../common/text.schema.json"
            }
          }
        }
      ]
    },
    "c08Training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutoff_date",
        "n_defaults",
        "n_open_workouts_excluded",
        "closure_rule"
      ],
      "properties": {
        "cutoff_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "n_defaults": {
          "type": "integer",
          "minimum": 0
        },
        "n_open_workouts_excluded": {
          "type": "integer",
          "minimum": 0
        },
        "closure_rule": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "Out-of-time by default date; the training set holds only defaults whose workout closed before the cutoff."
    },
    "c08Workout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discount_rate_convention",
        "discount_rate",
        "incomplete_workouts",
        "note"
      ],
      "properties": {
        "discount_rate_convention": {
          "type": "string",
          "enum": [
            "eba-interbank-plus-5pp",
            "fixed",
            "none-proxy"
          ]
        },
        "discount_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "incomplete_workouts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "treatment",
            "n_excluded",
            "n_projected",
            "reason"
          ],
          "properties": {
            "treatment": {
              "type": "string",
              "enum": [
                "excluded",
                "projected",
                "not-applicable"
              ]
            },
            "n_excluded": {
              "type": "integer",
              "minimum": 0
            },
            "n_projected": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "note": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "How realised LGD is built: a workout LGD discounts recoveries (rate convention EBA/GL/2017/16, paragraph UNVERIFIED); the SBA twin has no cash flows, so none-proxy and not-applicable."
    },
    "c08DownturnPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_year",
        "last_year",
        "indicator",
        "macro_source"
      ],
      "properties": {
        "first_year": {
          "type": "integer",
          "minimum": 1990
        },
        "last_year": {
          "type": "integer",
          "minimum": 1990
        },
        "indicator": {
          "type": "string"
        },
        "macro_source": {
          "type": "string"
        }
      }
    },
    "c08Coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "estimate",
        "std_error"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "estimate": {
          "type": "number"
        },
        "std_error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "c08RungSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rung_id",
        "kind",
        "covariates",
        "coefficients",
        "epsilon",
        "training_cutoff",
        "library",
        "library_version"
      ],
      "properties": {
        "rung_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ols",
            "fractional-logit",
            "beta",
            "hurdle",
            "tobit",
            "gradient-boosted",
            "cure-decomposition"
          ]
        },
        "covariates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coefficients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c08Coefficient"
          }
        },
        "epsilon": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 0.5
            },
            {
              "type": "null"
            }
          ],
          "description": "The endpoint transformation of beta rungs; null elsewhere."
        },
        "training_cutoff": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "library": {
          "type": "string"
        },
        "library_version": {
          "type": "string"
        }
      }
    },
    "c08FloorCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "portfolio",
        "collateral",
        "floor",
        "reference"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "portfolio": {
          "type": "string",
          "enum": [
            "corporate",
            "retail"
          ]
        },
        "collateral": {
          "type": "string",
          "enum": [
            "unsecured",
            "financial",
            "receivables",
            "real-estate",
            "other-physical",
            "qrre",
            "mortgage"
          ]
        },
        "floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A share or an observed rate in [0, 1]."
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "c08Floors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "cells",
        "source"
      ],
      "properties": {
        "regime": {
          "type": "string"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c08FloorCell"
          },
          "minItems": 1
        },
        "source": {
          "type": "string"
        }
      },
      "description": "The LGD floor cells transcribed from dossier 01 section A.5."
    },
    "c08DownturnSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approach",
        "period"
      ],
      "properties": {
        "approach": {
          "$ref": "../common/text.schema.json"
        },
        "period": {
          "$ref": "#/$defs/c08DownturnPeriod"
        }
      }
    },
    "c08Fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "lgd_proxy",
        "data_status",
        "cohorts",
        "training",
        "workout",
        "ladder",
        "downturn",
        "floors"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code of the money fields of this block."
        },
        "lgd_proxy": {
          "$ref": "#/$defs/c08LgdProxy"
        },
        "data_status": {
          "$ref": "#/$defs/c08DataStatus"
        },
        "cohorts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c08Cohort"
          },
          "minItems": 1
        },
        "training": {
          "$ref": "#/$defs/c08Training"
        },
        "workout": {
          "$ref": "#/$defs/c08Workout"
        },
        "ladder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c08RungSpec"
          },
          "minItems": 1
        },
        "downturn": {
          "$ref": "#/$defs/c08DownturnSpec"
        },
        "floors": {
          "$ref": "#/$defs/c08Floors"
        }
      },
      "description": "C08 models: the LGD proxy and its bias, the default cohorts, the rungs, the downturn specification and the floor cells."
    }
  }
}
