{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c11/models.schema.json",
  "title": "C11 models",
  "description": "Catalog row c11-models 1.0.0: the C11 models artifact (windows and spans, the ladder with its fitted parameters, the Basel bands, the ES reference points).",
  "allOf": [
    {
      "$ref": "../common/models-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C11"
        },
        "fit": {
          "$ref": "#/$defs/c11Fit"
        }
      },
      "required": [
        "case_id",
        "fit"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c11SignConvention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_convention",
        "document_convention",
        "definition"
      ],
      "properties": {
        "engine_convention": {
          "const": "return-negative"
        },
        "document_convention": {
          "const": "positive-loss"
        },
        "definition": {
          "allOf": [
            {
              "$ref": "../common/text.schema.json"
            },
            {
              "properties": {
                "en": {
                  "minLength": 1
                },
                "es": {
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "description": "The sign convention, a required field of every C11 document (dossier 05 A.0): the engine stores the return convention (VaR and ES negative at the tail level alpha 0.01 or 0.025, needed by the FZ0 loss) and the document stores positive loss numbers, the conversion made once at the reporting layer. The definition states both in words."
    },
    "c11Level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alpha"
      ],
      "properties": {
        "alpha": {
          "type": "number",
          "enum": [
            0.01,
            0.025
          ]
        }
      },
      "description": "A tail level of the return convention: 0.01 (99 percent VaR, the Basel level) or 0.025 (97.5 percent, the FRTB ES level)."
    },
    "c11Span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^(19\\d{2}|200[0-6])-\\d{2}-\\d{2}$",
          "description": "A date before 2007-01-01: the hyperparameters are fixed on a pre-2007 span (SDD C11)."
        },
        "end": {
          "type": "string",
          "pattern": "^(19\\d{2}|200[0-6])-\\d{2}-\\d{2}$",
          "description": "A date before 2007-01-01: the hyperparameters are fixed on a pre-2007 span (SDD C11)."
        }
      },
      "description": "The span on which the hyperparameters were fixed: it ends before 2007 and before the window it serves."
    },
    "c11WindowPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "asset_class",
        "start_date",
        "end_date",
        "fixed_on"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "enum": [
            "equity-2007-09",
            "equity-2020",
            "rates-2022",
            "fx-2008",
            "mixed-2023",
            "calm-2004-06"
          ]
        },
        "asset_class": {
          "type": "string",
          "enum": [
            "equity",
            "rates",
            "fx",
            "mixed"
          ]
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fixed_on": {
          "$ref": "#/$defs/c11Span"
        }
      },
      "description": "A window and the span on which its hyperparameters were fixed (before the window starts and before 2007)."
    },
    "c11Parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "min",
        "median",
        "max",
        "unit"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "median": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      },
      "description": "A fitted parameter across the refits of a window: minimum, median and maximum."
    },
    "c11RungWindowFit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "n_refits",
        "n_convergence_failures",
        "parameters"
      ],
      "properties": {
        "window_id": {
          "type": "string"
        },
        "n_refits": {
          "type": "integer",
          "minimum": 0
        },
        "n_convergence_failures": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11Parameter"
          }
        }
      }
    },
    "c11Rung": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "rung",
        "title",
        "family",
        "source",
        "status",
        "not_run_reason",
        "innovation",
        "estimation_window_days",
        "refit_every_days",
        "forecasts_es",
        "es_method",
        "window_fits"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "rung": {
          "type": "string",
          "pattern": "^R([1-9]|10)$"
        },
        "title": {
          "$ref": "../common/text.schema.json"
        },
        "family": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "The primary source of the method (dossier 05 A.2)."
        },
        "status": {
          "type": "string",
          "enum": [
            "fitted",
            "challenger-not-run"
          ]
        },
        "not_run_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "innovation": {
          "type": "string",
          "enum": [
            "none",
            "normal",
            "student-t",
            "skew-t",
            "gpd-tail",
            "empirical"
          ]
        },
        "estimation_window_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "refit_every_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "forecasts_es": {
          "type": "boolean"
        },
        "es_method": {
          "type": "string"
        },
        "window_fits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11RungWindowFit"
          }
        }
      },
      "description": "A rung of the market ladder (dossier 05 'Method ladders': rungs 1 to 10; rung 10 is a challenger only).",
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "status": {
                  "const": "fitted"
                },
                "not_run_reason": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "status": {
                  "const": "challenger-not-run"
                },
                "not_run_reason": {
                  "type": "string",
                  "minLength": 1
                },
                "window_fits": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/c11RungWindowFit"
                  },
                  "maxItems": 0
                }
              }
            }
          ]
        }
      ]
    },
    "c11TrafficRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exceptions",
        "zone",
        "frtb_multiplier",
        "us_multiplier",
        "cumulative_probability_pct"
      ],
      "properties": {
        "exceptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "The number of exceptions in 250 days; 10 stands for ten or more."
        },
        "zone": {
          "type": "string",
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "frtb_multiplier": {
          "type": "number",
          "description": "The backtesting-dependent multiplier m_c of MAR32.9 Table 1."
        },
        "us_multiplier": {
          "type": "number",
          "description": "The US multiplication factor of 12 CFR 217.204 Table 1 (dossier 05 B.4)."
        },
        "cumulative_probability_pct": {
          "type": "number",
          "description": "P(X <= exceptions), X ~ Bin(250, 0.01), in percent (MAR32.9 Table 1)."
        }
      }
    },
    "c11TrafficTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_days",
        "confidence",
        "reference",
        "rows"
      ],
      "properties": {
        "window_days": {
          "const": 250
        },
        "confidence": {
          "const": 0.99
        },
        "reference": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11TrafficRow"
          },
          "minItems": 11,
          "maxItems": 11
        }
      },
      "description": "MAR32.9 Table 1 with the US factors (dossier 01 D.4, dossier 05 B.4); the reference for every traffic-light band."
    },
    "c11EsReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "n_days",
        "alpha",
        "yellow",
        "red",
        "status"
      ],
      "properties": {
        "statistic": {
          "const": "Z2"
        },
        "n_days": {
          "const": 250
        },
        "alpha": {
          "const": 0.025
        },
        "yellow": {
          "const": -0.7
        },
        "red": {
          "const": -1.8
        },
        "status": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The published reference points of Acerbi and Szekely for Z2 (dossier 05 B.5): a reference, never a regulatory threshold; each model's own simulated critical values are in the outputs."
    },
    "c11Scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fz0_formula",
        "tick_formula",
        "hac_kernel",
        "mcs_confidence",
        "mcs_statistic",
        "selection_rule"
      ],
      "properties": {
        "fz0_formula": {
          "type": "string"
        },
        "tick_formula": {
          "type": "string"
        },
        "hac_kernel": {
          "const": "bartlett"
        },
        "mcs_confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "mcs_statistic": {
          "type": "string",
          "enum": [
            "Tmax",
            "TR"
          ]
        },
        "selection_rule": {
          "$ref": "../common/text.schema.json"
        }
      }
    },
    "c11Gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "rule"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^market\\."
        },
        "rule": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "An eligibility gate: the model is ineligible when the row of this test is red at any level."
    },
    "c11Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_id",
        "title",
        "source_class",
        "url",
        "licence_note"
      ],
      "properties": {
        "series_id": {
          "type": "string"
        },
        "title": {
          "$ref": "../common/text.schema.json"
        },
        "source_class": {
          "type": "string",
          "enum": [
            "derived-only",
            "mirror-allowed"
          ]
        },
        "url": {
          "type": "string"
        },
        "licence_note": {
          "$ref": "../common/text.schema.json"
        }
      }
    },
    "c11Fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sign_convention",
        "levels",
        "windows",
        "ladder",
        "traffic_light",
        "es_reference",
        "scoring",
        "eligibility_gates",
        "data_sources"
      ],
      "properties": {
        "sign_convention": {
          "$ref": "#/$defs/c11SignConvention"
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11Level"
          },
          "minItems": 1
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11WindowPlan"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "ladder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11Rung"
          },
          "minItems": 1
        },
        "traffic_light": {
          "$ref": "#/$defs/c11TrafficTable"
        },
        "es_reference": {
          "$ref": "#/$defs/c11EsReference"
        },
        "scoring": {
          "$ref": "#/$defs/c11Scoring"
        },
        "eligibility_gates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11Gate"
          },
          "minItems": 1
        },
        "data_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c11Source"
          },
          "minItems": 1
        }
      },
      "description": "The C11 models document: the six windows, the ladder, the bands and the reference points the views draw."
    }
  }
}
