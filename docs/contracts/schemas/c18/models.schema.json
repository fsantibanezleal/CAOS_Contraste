          "$ref": "#/$defs/c18NamedMatrix"
        },
        "ppnr_fee_ratio": {
          "$ref": "#/$defs/c18Named"
        },
        "ppnr_cost_ratio": {
          "$ref": "#/$defs/c18Named"
        },
        "c_p2": {
          "$ref": "#/$defs/c18Named"
        },
        "c_d": {
          "$ref": "#/$defs/c18Named"
        },
