{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c21/models.schema.json",
  "title": "C21 models",
  "description": "Catalog row c21-models 1.0.0: the HMDA fields, the fitted decision models and the conventions.",
  "allOf": [
    {
      "$ref": "../common/models-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C21"
        },
        "fit": {
          "$ref": "#/$defs/c21Fit"
        }
      },
      "required": [
        "case_id",
        "fit"
      ]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c21Hmda": {
      "enum": [
        "derived_race",
        "derived_ethnicity",
        "derived_sex",
        "applicant_age",
        "debt_to_income_ratio",
        "combined_loan_to_value_ratio",
        "income",
        "loan_amount",
        "property_value",
        "loan_type",
        "loan_purpose",
        "lien_status",
        "occupancy_type",
        "applicant_age_above_62",
        "action_taken",
        "rate_spread",
        "denial_reason_1",
        "denial_reason_2",
        "denial_reason_3",
        "denial_reason_4"
      ]
    },
    "c21Label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "const": "no legal claim"
        },
        "es": {
          "const": "sin afirmacion legal"
        }
      },
      "description": "The required label, on every C21 document."
    },
    "c21Legal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "regulation_b",
        "fair_housing_act",
        "procedures",
        "unconditional_rates_are",
        "controlled_disparity_is",
        "is_a_finding_of_violation"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/c21Label"
        },
        "regulation_b": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "quote",
            "text"
          ],
          "properties": {
            "citation": {
              "const": "12 CFR 1002.6(a), as amended at 91 FR 21668 (2026-04-22, effective 2026-07-21)"
            },
            "quote": {
              "const": "The Act does not provide that the 'effects test' applies for determining whether there is discrimination in violation of the Act."
            },
            "text": {
              "$ref": "../common/text.schema.json"
            }
          }
        },
        "fair_housing_act": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "quote",
            "text"
          ],
          "properties": {
            "citation": {
              "const": "91 FR 21620, recital of Texas Department of Housing & Community Affairs v. Inclusive Communities Project, Inc."
            },
            "quote": {
              "const": "the Supreme Court held that disparate-impact claims are cognizable under the Fair Housing Act (FHA)."
            },
            "text": {
              "$ref": "../common/text.schema.json"
            }
          }
        },
        "procedures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "quote",
            "text"
          ],
          "properties": {
            "citation": {
              "const": "Interagency Fair Lending Examination Procedures, August 2009, appendix, printed page 26"
            },
            "quote": {
              "const": "Gross HMDA denial or approval rate disparities are not appropriate for disproportionate adverse impact analysis because they typically cannot be attributed to a specific policy or criterion."
            },
            "text": {
              "$ref": "../common/text.schema.json"
            }
          }
        },
        "unconditional_rates_are": {
          "const": "indicators-only"
        },
        "controlled_disparity_is": {
          "const": "approximation-of-comparative-evidence"
        },
        "is_a_finding_of_violation": {
          "const": false
        }
      },
      "description": "No legal claim: the sentences the U14 research addendum quotes (H3 4.1 and 4.3), decision C4."
    },
    "c21Conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "outcome",
        "dti_recode",
        "group_exclusion",
        "identifiers"
      ],
      "properties": {
        "label": {
          "const": "convention",
          "description": "Every named parameter carries this label: a convention, never a regulatory threshold (06 I.6 l.1268-1270)."
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval_codes",
            "denial_codes",
            "excluded_codes",
            "note"
          ],
          "properties": {
            "approval_codes": {
              "const": [
                1,
                2
              ]
            },
            "denial_codes": {
              "const": [
                3
              ]
            },
            "excluded_codes": {
              "const": [
                4,
                5,
                6,
                7,
                8
              ]
            },
            "note": {
              "$ref": "../common/text.schema.json"
            }
          },
          "description": "approval = 1 and 2, denial = 3; 4 and 5 have no decision; 6, 7 and 8 left out (decision C3)."
        },
        "dti_recode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bins",
            "note"
          ],
          "properties": {
            "bins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "note": {
              "$ref": "../common/text.schema.json"
            }
          },
          "description": "The mixed exact and binned debt-to-income field is recoded to the published bins (decision C2)."
        },
        "group_exclusion": {
          "$ref": "../common/text.schema.json"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "observation_date",
            "label",
            "note"
          ],
          "properties": {
            "id": {
              "const": "<activity_year>-<row>"
            },
            "observation_date": {
              "const": "<activity_year>-12-31"
            },
            "label": {
              "const": "convention",
              "description": "Every named parameter carries this label: a convention, never a regulatory threshold (06 I.6 l.1268-1270)."
            },
            "note": {
              "$ref": "../common/text.schema.json"
            }
          },
          "description": "Public HMDA withholds the loan identifier and the dates (addendum H1 2.5): id is the row position in the source file within its activity year, observation_date is the activity year's 12-31 (decision V3)."
        }
      },
      "description": "Named conventions, labelled on every result."
    },
    "c21Licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "platform_terms",
        "platform_terms_cover",
        "modified_statement",
        "note"
      ],
      "properties": {
        "status": {
          "const": "UNVERIFIED"
        },
        "platform_terms": {
          "const": "As a work of the United States Government, this package (excluding any exceptions listed below) is in the public domain within the United States. Additionally, we waive copyright and related rights in the work worldwide through the CC0 1.0 Universal public domain dedication."
        },
        "platform_terms_cover": {
          "const": "the software package, not the published datasets"
        },
        "modified_statement": {
          "const": "The publicly available data are modified to protect applicants' and borrowers' privacy"
        },
        "note": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The HMDA data licence stays UNVERIFIED (addendum H2 3.3); the views quote the platform software terms and the CFPB statement that the public data are modified (decision C7)."
    },
    "c21Note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "treatment",
        "n_missing",
        "reason"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/c21Hmda"
        },
        "treatment": {
          "enum": [
            "unmodified",
            "binned",
            "rounded",
            "top-coded",
            "bottom-coded",
            "withheld",
            "not-applicable"
          ]
        },
        "n_missing": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "A field HMDA withholds or bins in the public release: a nullable value with its reason, never a fabricated number."
    },
    "c21Fit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "decision_models",
        "conventions",
        "legal",
        "licence",
        "data_notes"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "alias"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/c21Hmda"
              },
              "role": {
                "enum": [
                  "attribute",
                  "control",
                  "outcome",
                  "reason",
                  "pricing",
                  "flag"
                ]
              },
              "alias": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 1
        },
        "decision_models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fit_year",
              "kind",
              "outcome",
              "n",
              "converged",
              "terms"
            ],
            "properties": {
              "fit_year": {
                "type": "integer",
                "minimum": 2018,
                "maximum": 2023
              },
              "kind": {
                "enum": [
                  "logistic",
                  "linear"
                ]
              },
              "outcome": {
                "enum": [
                  "approval",
                  "rate_spread"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "converged": {
                "type": "boolean"
              },
              "terms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "term",
                    "coefficient",
                    "se"
                  ],
                  "properties": {
                    "term": {
                      "type": "string",
                      "minLength": 1
                    },
                    "coefficient": {
                      "type": "number"
                    },
                    "se": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        },
        "conventions": {
          "$ref": "#/$defs/c21Conventions"
        },
        "legal": {
          "$ref": "#/$defs/c21Legal"
        },
        "licence": {
          "$ref": "#/$defs/c21Licence"
        },
        "data_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Note"
          },
          "minItems": 1
        }
      },
      "description": "C21 models: the HMDA fields used (addendum H1 names), the fitted decision models and the conventions."
    }
  }
}
