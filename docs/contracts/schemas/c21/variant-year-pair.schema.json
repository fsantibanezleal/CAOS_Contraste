{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c21/variant-year-pair.schema.json",
  "title": "C21 year-pair variant",
  "description": "Catalog row c21-outputs 2.0.0: one HMDA year pair, fitted on year t and confirmed on t+1 (outputs.kind year-pair). No legal claim.",
  "allOf": [
    {
      "$ref": "../common/variant-envelope.schema.json"
    },
    {
      "properties": {
        "case_id": {
          "const": "C21"
        },
        "outputs": {
          "$ref": "#/$defs/c21Outputs",
          "properties": {
            "kind": {
              "const": "year-pair"
            }
          }
        }
      },
      "required": [
        "case_id",
        "outputs"
      ]
    },
    {
      "properties": {
        "tests": {
          "items": {
            "if": {
              "properties": {
                "light": {
                  "const": "not_evaluated"
                }
              },
              "required": [
                "light"
              ]
            },
            "then": {
              "properties": {
                "statistic": {
                  "type": "null"
                },
                "p_value": {
                  "type": "null"
                },
                "metric": {
                  "type": "null"
                },
                "notes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "tests": {
          "items": {
            "properties": {
              "test_id": {
                "enum": [
                  "fair.demographic_parity",
                  "fair.adverse_impact",
                  "fair.two_proportion_z",
                  "fair.fisher_exact",
                  "fair.conditional_disparity",
                  "fair.rate_spread_disparity",
                  "fair.replication",
                  "fair.situation_testing"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c21Hmda": {
      "enum": [
        "derived_race",
        "derived_ethnicity",
        "derived_sex",
        "applicant_age",
        "debt_to_income_ratio",
        "combined_loan_to_value_ratio",
        "income",
        "loan_amount",
        "property_value",
        "loan_type",
        "loan_purpose",
        "lien_status",
        "occupancy_type",
        "applicant_age_above_62",
        "action_taken",
        "rate_spread",
        "denial_reason_1",
        "denial_reason_2",
        "denial_reason_3",
        "denial_reason_4"
      ]
    },
    "c21Control": {
      "enum": [
        "debt_to_income_ratio",
        "combined_loan_to_value_ratio",
        "income",
        "loan_amount",
        "property_value",
        "loan_type",
        "loan_purpose",
        "lien_status",
        "occupancy_type"
      ]
    },
    "c21Label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "const": "no legal claim"
        },
        "es": {
          "const": "sin afirmación legal"
        }
      },
      "description": "The required label, on every C21 document."
    },
    "c21Legal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "regulation_b",
        "fair_housing_act",
        "procedures",
        "unconditional_rates_are",
        "controlled_disparity_is",
        "is_a_finding_of_violation"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/c21Label"
        },
        "regulation_b": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "quote",
            "text"
          ],
          "properties": {
            "citation": {
              "const": "12 CFR 1002.6(a), as amended at 91 FR 21668 (2026-04-22, effective 2026-07-21)"
            },
            "quote": {
              "const": "The Act does not provide that the 'effects test' applies for determining whether there is discrimination in violation of the Act."
            },
            "text": {
              "$ref": "../common/text.schema.json"
            }
          }
        },
        "fair_housing_act": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "quote",
            "text"
          ],
          "properties": {
            "citation": {
              "const": "91 FR 21620, recital of Texas Department of Housing & Community Affairs v. Inclusive Communities Project, Inc."
            },
            "quote": {
              "const": "the Supreme Court held that disparate-impact claims are cognizable under the Fair Housing Act (FHA)."
            },
            "text": {
              "$ref": "../common/text.schema.json"
            }
          }
        },
        "procedures": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation",
            "quote",
            "text"
          ],
          "properties": {
            "citation": {
              "const": "Interagency Fair Lending Examination Procedures, August 2009, appendix, printed page 26"
            },
            "quote": {
              "const": "Gross HMDA denial or approval rate disparities are not appropriate for disproportionate adverse impact analysis because they typically cannot be attributed to a specific policy or criterion."
            },
            "text": {
              "$ref": "../common/text.schema.json"
            }
          }
        },
        "unconditional_rates_are": {
          "const": "indicators-only"
        },
        "controlled_disparity_is": {
          "const": "approximation-of-comparative-evidence"
        },
        "is_a_finding_of_violation": {
          "const": false
        }
      },
      "description": "No legal claim: the sentences the U14 research addendum quotes (H3 4.1 and 4.3), decision C4."
    },
    "c21Group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "n",
        "n_approved",
        "n_denied",
        "selection_rate"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "n_approved": {
          "type": "integer",
          "minimum": 0
        },
        "n_denied": {
          "type": "integer",
          "minimum": 0
        },
        "selection_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A value in [0, 1]."
        }
      }
    },
    "c21Excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "n",
        "reason"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "A non-attribute category (Joint, Not Available, Free Form Text Only): carried as its own group and excluded from the pairwise tests (decision C2)."
    },
    "c21Test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "p_value"
      ],
      "properties": {
        "statistic": {
          "type": "number"
        },
        "p_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A value in [0, 1]."
        }
      }
    },
    "c21Air": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "note"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Protected group's selection rate over the reference group's: the parity ratio, null when the reference rate is 0. It is not the four-fifths ratio, which is taken against the highest-rate group (the attribute's four_fifths block)."
        },
        "note": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The adverse impact ratio against the chosen reference group."
    },
    "c21FourFifthsRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "ratio_to_highest",
        "flag"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "ratio_to_highest": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "The group's selection rate over the highest group's rate; null when the highest rate is 0."
        },
        "flag": {
          "type": "boolean"
        }
      },
      "description": "One group against the highest-rate group; the flag is decided on the counts in exact arithmetic, never on the float ratio."
    },
    "c21FourFifths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "citation",
        "threshold",
        "is_credit_law_threshold",
        "compared_with",
        "decided_on",
        "rule",
        "highest_rate_group",
        "groups"
      ],
      "properties": {
        "label": {
          "const": "employment benchmark"
        },
        "citation": {
          "const": "29 CFR 1607.4(D)"
        },
        "threshold": {
          "const": 0.8
        },
        "is_credit_law_threshold": {
          "const": false
        },
        "compared_with": {
          "const": "highest-rate-group"
        },
        "decided_on": {
          "const": "exact-counts"
        },
        "rule": {
          "const": "flag when 5 * x_g * n_h < 4 * x_h * n_g"
        },
        "highest_rate_group": {
          "type": "string",
          "minLength": 1,
          "description": "The group with the highest selection rate (the first of them in groups order on a tie)."
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21FourFifthsRow"
          },
          "minItems": 2,
          "description": "One row per group of the attribute, the highest-rate group included (ratio 1, no flag)."
        }
      },
      "description": "The four-fifths line is an employment benchmark and never a credit-law threshold (06 C.7 l.1033-1037, I.6 l.1268-1270). It compares each group with the highest-rate group (29 CFR 1607.4(D); 06 C.7 l.1034-1035), decided on the counts: a group is flagged when 5 * x_g * n_h < 4 * x_h * n_g, so exactly four-fifths is not flagged."
    },
    "c21Ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lo",
        "hi",
        "level"
      ],
      "properties": {
        "lo": {
          "type": "number"
        },
        "hi": {
          "type": "number"
        },
        "level": {
          "const": 0.95
        }
      }
    },
    "c21Controlled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "outcome",
        "coefficient",
        "odds_ratio",
        "ci",
        "n",
        "controls",
        "missing_controls",
        "label"
      ],
      "properties": {
        "model": {
          "const": "logistic-decision-model"
        },
        "outcome": {
          "const": "approval"
        },
        "coefficient": {
          "type": "number"
        },
        "odds_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ci": {
          "$ref": "#/$defs/c21Ci"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Control"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "missing_controls": {
          "type": "array",
          "items": {
            "enum": [
              "credit_score"
            ]
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Public HMDA has no credit score: every controlled estimate names it as a missing control (decision C2)."
        },
        "label": {
          "const": "approximation of comparative evidence"
        }
      },
      "description": "Logistic decision model of approval on the protected attribute and the permitted underwriting controls (decision Q4)."
    },
    "c21RateSpread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "population",
        "coefficient",
        "ci",
        "n",
        "controls",
        "missing_controls",
        "label",
        "unit"
      ],
      "properties": {
        "model": {
          "const": "linear-rate-spread"
        },
        "population": {
          "const": "action_taken 1 or 2"
        },
        "coefficient": {
          "type": "number"
        },
        "ci": {
          "$ref": "#/$defs/c21Ci"
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Control"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "missing_controls": {
          "type": "array",
          "items": {
            "enum": [
              "credit_score"
            ]
          },
          "minItems": 1,
          "maxItems": 1,
          "description": "Public HMDA has no credit score: every controlled estimate names it as a missing control (decision C2)."
        },
        "label": {
          "const": "approximation of comparative evidence"
        },
        "unit": {
          "const": "percentage points of rate_spread"
        }
      },
      "description": "Linear model of the rate spread on the same terms; the loans that carry rate_spread (action taken 1 and 2)."
    },
    "c21Confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit_year",
        "confirm_year",
        "fit_coefficient",
        "confirm_coefficient",
        "same_sign",
        "size_ratio"
      ],
      "properties": {
        "fit_year": {
          "type": "integer",
          "minimum": 2018,
          "maximum": 2023
        },
        "confirm_year": {
          "type": "integer",
          "minimum": 2019,
          "maximum": 2024
        },
        "fit_coefficient": {
          "type": "number"
        },
        "confirm_coefficient": {
          "type": "number"
        },
        "same_sign": {
          "type": "boolean"
        },
        "size_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "confirm coefficient over fit coefficient; null when the fit coefficient is 0."
        }
      },
      "description": "Confirmation on year t+1 by sign and size (decision Q4)."
    },
    "c21OptControlled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "reason"
      ],
      "properties": {
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/c21Controlled"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "The estimate, or null with its reason (missing-data behavior).",
      "oneOf": [
        {
          "properties": {
            "estimate": {
              "$ref": "#/$defs/c21Controlled"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "estimate": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "c21OptRateSpread": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "reason"
      ],
      "properties": {
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/c21RateSpread"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "The estimate, or null with its reason (missing-data behavior).",
      "oneOf": [
        {
          "properties": {
            "estimate": {
              "$ref": "#/$defs/c21RateSpread"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "estimate": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "c21OptConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "reason"
      ],
      "properties": {
        "estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/c21Confirmation"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "The estimate, or null with its reason (missing-data behavior).",
      "oneOf": [
        {
          "properties": {
            "estimate": {
              "$ref": "#/$defs/c21Confirmation"
            },
            "reason": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "estimate": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "c21Contrast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "reference_group",
        "n_group",
        "n_reference",
        "selection_rate_group",
        "selection_rate_reference",
        "parity_gap",
        "parity_ratio",
        "adverse_impact_ratio",
        "z_test",
        "fisher_exact",
        "controlled",
        "rate_spread",
        "confirmation"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "reference_group": {
          "type": "string",
          "minLength": 1
        },
        "n_group": {
          "type": "integer",
          "minimum": 1
        },
        "n_reference": {
          "type": "integer",
          "minimum": 1
        },
        "selection_rate_group": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A value in [0, 1]."
        },
        "selection_rate_reference": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "A value in [0, 1]."
        },
        "parity_gap": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Group rate minus reference rate."
        },
        "parity_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "adverse_impact_ratio": {
          "$ref": "#/$defs/c21Air"
        },
        "z_test": {
          "$ref": "#/$defs/c21Test"
        },
        "fisher_exact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "odds_ratio",
            "p_value"
          ],
          "properties": {
            "odds_ratio": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "p_value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "A value in [0, 1]."
            }
          }
        },
        "controlled": {
          "$ref": "#/$defs/c21OptControlled"
        },
        "rate_spread": {
          "$ref": "#/$defs/c21OptRateSpread"
        },
        "confirmation": {
          "$ref": "#/$defs/c21OptConfirmation"
        }
      }
    },
    "c21Attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "legal",
        "reference_group",
        "groups",
        "excluded_groups",
        "four_fifths",
        "contrasts"
      ],
      "properties": {
        "field": {
          "enum": [
            "derived_race",
            "derived_ethnicity",
            "derived_sex",
            "applicant_age"
          ]
        },
        "legal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "ecoa",
            "fha",
            "note",
            "theory",
            "fha_disparate_impact"
          ],
          "properties": {
            "basis": {
              "enum": [
                "race_color",
                "national_origin_nearest_UNVERIFIED",
                "sex",
                "age_ecoa_only"
              ]
            },
            "ecoa": {
              "type": "boolean"
            },
            "fha": {
              "type": "boolean"
            },
            "note": {
              "$ref": "../common/text.schema.json"
            },
            "theory": {
              "const": "comparative-evidence-of-disparate-treatment"
            },
            "fha_disparate_impact": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "The legal mapping of the attribute, from the addendum H3 section 5 table only."
        },
        "reference_group": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Group"
          },
          "minItems": 2
        },
        "excluded_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Excluded"
          },
          "minItems": 0
        },
        "four_fifths": {
          "$ref": "#/$defs/c21FourFifths"
        },
        "contrasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Contrast"
          },
          "minItems": 1
        }
      },
      "oneOf": [
        {
          "properties": {
            "field": {
              "const": "derived_race"
            },
            "legal": {
              "properties": {
                "basis": {
                  "const": "race_color"
                },
                "ecoa": {
                  "const": true
                },
                "fha": {
                  "const": true
                },
                "fha_disparate_impact": {
                  "const": "not assessed (disparate impact under the FHA only; gross HMDA disparities are not appropriate for disproportionate adverse impact analysis, Interagency Procedures appendix, printed page 26)"
                }
              }
            },
            "reference_group": {
              "enum": [
                "American Indian or Alaska Native",
                "Asian",
                "Black or African American",
                "Native Hawaiian or Other Pacific Islander",
                "White",
                "2 or more minority races"
              ]
            },
            "groups": {
              "items": {
                "properties": {
                  "group": {
                    "enum": [
                      "American Indian or Alaska Native",
                      "Asian",
                      "Black or African American",
                      "Native Hawaiian or Other Pacific Islander",
                      "White",
                      "2 or more minority races"
                    ]
                  }
                }
              }
            },
            "excluded_groups": {
              "items": {
                "properties": {
                  "group": {
                    "enum": [
                      "Joint",
                      "Free Form Text Only",
