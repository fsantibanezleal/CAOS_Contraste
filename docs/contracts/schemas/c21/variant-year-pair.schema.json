              "minimum": 1
            },
            "rows_confirm": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "legal": {
          "$ref": "#/$defs/c21Legal"
        },
        "licence": {
          "$ref": "#/$defs/c21Licence"
        },
        "conventions": {
          "$ref": "#/$defs/c21Conventions"
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Attribute"
          },
          "minItems": 1
        },
        "situation_testing": {
          "$ref": "#/$defs/c21Situation"
        },
        "data_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/c21Note"
          },
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^CT-21\\d\\d$"
          },
          "minItems": 1,
          "description": "Requirement ids CT-2101 onward (decision Q14)."
        }
      },
      "description": "C21 year-pair outputs: statistical disparity on public HMDA decisions, fitted on year t and confirmed on t+1. No outcome-conditioned test runs: HMDA has no outcome (08 l.180-181).",
      "oneOf": [
        {
          "properties": {
