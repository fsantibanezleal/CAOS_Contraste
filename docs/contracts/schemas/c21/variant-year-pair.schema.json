    "c21Conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "outcome",
        "dti_recode",
        "group_exclusion",
        "identifiers"
      ],
      "properties": {
        "label": {
          "const": "convention",
          "description": "Every named parameter carries this label: a convention, never a regulatory threshold (06 I.6 l.1268-1270)."
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approval_codes",
            "denial_codes",
            "excluded_codes",
            "note"
          ],
          "properties": {
            "approval_codes": {
              "const": [
                1,
                2
              ]
            },
            "denial_codes": {
              "const": [
                3
              ]
            },
            "excluded_codes": {
              "const": [
                4,
                5,
                6,
                7,
                8
              ]
            },
            "note": {
              "$ref": "../common/text.schema.json"
            }
          },
          "description": "approval = 1 and 2, denial = 3; 4 and 5 have no decision; 6, 7 and 8 left out (decision C3)."
        },
        "dti_recode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bins",
            "note"
          ],
          "properties": {
            "bins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "note": {
              "$ref": "../common/text.schema.json"
            }
          },
          "description": "The mixed exact and binned debt-to-income field is recoded to the published bins (decision C2)."
        },
        "group_exclusion": {
          "$ref": "../common/text.schema.json"
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "observation_date",
            "label",
            "note"
          ],
          "properties": {
            "id": {
              "const": "<activity_year>-<row>"
            },
            "observation_date": {
              "const": "<activity_year>-12-31"
            },
            "label": {
              "const": "convention",
              "description": "Every named parameter carries this label: a convention, never a regulatory threshold (06 I.6 l.1268-1270)."
            },
            "note": {
              "$ref": "../common/text.schema.json"
            }
          },
          "description": "Public HMDA withholds the loan identifier and the dates (addendum H1 2.5): id is the row position in the source file within its activity year, observation_date is the activity year's 12-31 (decision V3)."
        }
      },
      "description": "Named conventions, labelled on every result."
    },
    "c21Licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "platform_terms",
        "platform_terms_cover",
        "modified_statement",
        "note"
      ],
      "properties": {
        "status": {
          "const": "UNVERIFIED"
        },
        "platform_terms": {
          "const": "As a work of the United States Government, this package (excluding any exceptions listed below) is in the public domain within the United States. Additionally, we waive copyright and related rights in the work worldwide through the CC0 1.0 Universal public domain dedication."
        },
        "platform_terms_cover": {
          "const": "the software package, not the published datasets"
        },
        "modified_statement": {
          "const": "The publicly available data are modified to protect applicants' and borrowers' privacy"
        },
        "note": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "The HMDA data licence stays UNVERIFIED (addendum H2 3.3); the views quote the platform software terms and the CFPB statement that the public data are modified (decision C7)."
    },
    "c21Note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "treatment",
        "n_missing",
        "reason"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/c21Hmda"
        },
        "treatment": {
          "enum": [
            "unmodified",
            "binned",
            "rounded",
            "top-coded",
            "bottom-coded",
            "withheld",
            "not-applicable"
          ]
        },
        "n_missing": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "../common/text.schema.json"
        }
      },
      "description": "A field HMDA withholds or bins in the public release: a nullable value with its reason, never a fabricated number."
    },
    "c21Situation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "comparator",
        "counterfactual_test",
        "attribute",
        "k",
        "alpha",
        "tau",
        "distance_normalization",
        "label_parameters",
        "centers",
        "interval",
        "n_complainants",
        "n_cases",
        "n_significant"
      ],
      "properties": {
        "label": {
          "const": "situation-testing"
        },
        "comparator": {
          "const": "ceteris-paribus"
        },
        "counterfactual_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run",
            "reason"
          ],
          "properties": {
            "run": {
              "const": false
            },
            "reason": {
              "$ref": "../common/text.schema.json"
            }
          },
          "description": "Public HMDA gives no counterfactual dataset, so the counterfactual test is not run here (decision C6)."
        },
        "attribute": {
          "enum": [
            "derived_race",
            "derived_ethnicity",
            "derived_sex",
            "applicant_age"
          ]
        },
        "k": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "const": 0.05
        },
        "tau": {
          "const": 0
        },
        "distance_normalization": {
          "const": "range"
        },
        "label_parameters": {
          "const": "convention",
          "description": "Every named parameter carries this label: a convention, never a regulatory threshold (06 I.6 l.1268-1270)."
        },
        "centers": {
          "const": "excluded"
        },
        "interval": {
          "const": "one-sided Wald, equation (10) of arXiv 2502.01267"
        },
        "n_complainants": {
          "type": "integer",
          "minimum": 0
        },
        "n_cases": {
          "type": "integer",
          "minimum": 0
        },
        "n_significant": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Situation testing, ceteris paribus comparator only (algorithm of the addendum H5)."
    },
    "c21Outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pair_id",
        "fit_year",
        "confirm_year",
        "scope",
        "legal",
        "licence",
        "conventions",
        "attributes",
        "situation_testing",
        "data_notes",
        "requirements"
      ],
      "properties": {
        "kind": {
          "const": "year-pair"
        },
        "pair_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^20(18|19|20|21|22|23)-(19|20|21|22|23|24)$"
        },
        "fit_year": {
          "type": "integer",
          "minimum": 2018,
          "maximum": 2023
        },
