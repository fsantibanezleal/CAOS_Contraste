{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/contracts/c22/variant.schema.json",
  "title": "C22 validator variant",
  "description": "Catalog row c22-variant 3.0.0: one validation harness run (outputs.kind validator). The test ids, the families (variants) and the panels are closed enums; the simulations of the engine's named studies carry a study block, every other simulation a null one.",
  "allOf": [
    {"$ref": "../common/variant-envelope.schema.json"},
    {
      "properties": {
        "case_id": {"const": "C22"},
        "outputs": {
          "$ref": "#/$defs/c22Outputs",
          "properties": {
            "kind": {"const": "validator"}
          }
        }
      },
      "required": ["case_id","outputs"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "c22Curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","label","x_label","y_label","x","series"],
      "properties": {
        "id": {"type": "string"},
        "label": {"$ref": "../common/text.schema.json"},
        "x_label": {"$ref": "../common/text.schema.json"},
        "y_label": {"$ref": "../common/text.schema.json"},
        "x": {
          "type": "array",
          "items": {"type": "number"}
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id","label","y"],
            "properties": {
              "id": {"type": "string"},
              "label": {"$ref": "../common/text.schema.json"},
              "y": {
                "type": "array",
                "items": {"type": ["number","null"]}
              }
            }
          }
        }
      }
    },
    "c22Generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name","config","truth"],
      "properties": {
        "name": {"type": "string"},
        "config": {},
        "truth": {}
      }
    },
    "c22Golden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study","title","runs_published","runs","cells","agree","total","note"],
      "properties": {
        "study": {"type": "string"},
        "title": {"$ref": "../common/text.schema.json"},
        "runs_published": {"type": "integer"},
        "runs": {"type": "integer"},
        "cells": {
          "type": "array",
          "items": {"$ref": "#/$defs/c22GoldenCell"}
        },
        "agree": {"type": "integer"},
        "total": {"type": "integer"},
        "note": {"$ref": "../common/text.schema.json"}
      }
    },
    "c22GoldenCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table","row","column","published","measured","z","agrees"],
      "properties": {
        "table": {"type": "string"},
        "row": {"type": "string"},
        "column": {"type": "string"},
        "published": {"type": "number"},
        "measured": {"type": "number"},
        "z": {"type": ["number","null"]},
        "agrees": {"type": "boolean"}
      }
    },
    "c22Outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "family",
        "ladder",
        "levels",
        "panels",
        "simulations",
        "generators",
        "golden",
        "exact_curves",
        "estimators",
        "specimen",
        "size_bounds",
        "sequential"
      ],
      "properties": {
        "kind": {"const": "validator"},
        "family": {"type": "string", "enum": [
          "null",
          "miscalibration",
          "clustering",
          "drift",
          "discrimination-decay",
          "leakage",
          "broken-monotonicity",
          "concentration",
          "other-families"
        ]},
        "ladder": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["values","label"],
              "properties": {
                "values": {
                  "type": "array",
                  "items": {"type": "number"}
                },
                "label": {"$ref": "../common/text.schema.json"}
              }
            },
            {"type": "null"}
          ]
        },
        "levels": {
          "type": "array",
          "items": {"type": "number"}
        },
        "panels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id","label","axis","measures"],
            "properties": {
              "id": {"type": "string", "enum": [
                "calibration",
                "discrimination",
                "stability",
                "rating",
                "transitions",
                "settings",
                "portfolio",
                "grades",
                "obligors",
                "years",
                "ecb",
                "delong",
                "development",
                "auc",
                "feature",
                "migration-500",
                "migration-2000",
                "curve",
                "counts",
                "ccr",
                "ifrs9",
                "lgd-ead",
                "market-var",
                "market-es",
                "portfolio-credit",
                "fairness",
                "ml"
              ]},
              "label": {"$ref": "../common/text.schema.json"},
              "axis": {
                "anyOf": [
                  {"$ref": "../common/text.schema.json"},
                  {"type": "null"}
                ]
              },
              "measures": {"type": "string", "enum": ["power","size"]}
            }
          },
          "description": "axis: the x axis of a panel whose simulations do not run along the family's ladder; measures: whether its rates are"
        },
        "simulations": {
          "type": "array",
          "items": {"$ref": "#/$defs/c22Simulation"}
        },
        "generators": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/c22Generator"}
        },
        "golden": {
          "type": "array",
          "items": {"$ref": "#/$defs/c22Golden"}
        },
        "exact_curves": {
          "type": "array",
          "items": {"$ref": "#/$defs/c22Curve"}
        },
        "estimators": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["auc","ece_when_right"],
              "properties": {
                "auc": {
                  "type": "object",
                  "additionalProperties": {"type": "number"}
                },
                "ece_when_right": {
                  "type": "object",
                  "additionalProperties": {"type": "number"}
                }
              }
            },
            {"type": "null"}
          ]
        },
        "specimen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["severity"],
          "properties": {
            "severity": {"type": "integer"}
          }
        },
        "size_bounds": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "sequential": {
          "description": "BS-15 (unit D15): the engine's e-process sequential monitors against the fixed-window tests read every day; null on every variant but other-families.",
          "anyOf": [
            {"$ref": "#/$defs/c22Sequential"},
            {"type": "null"}
          ]
        }
      }
    },
    "c22Rate": {
      "description": "One rejection rate of the harness: rejections of n repetitions, its Monte Carlo SE and Wilson interval.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rejections","n","undefined","rate","se","wilson_low","wilson_high"],
      "properties": {
        "rejections": {"type": "integer", "minimum": 0},
        "n": {"type": "integer", "minimum": 0},
        "undefined": {"type": "integer", "minimum": 0},
        "rate": {"type": "number"},
        "se": {"type": "number"},
        "wilson_low": {"type": "number"},
        "wilson_high": {"type": "number"}
      }
    },
    "c22Simulation": {
      "description": "One simulation: a registered test on one generator at one severity, its rates per rule (\"p<0.05\", \"p<0.01\", and rules such as \"metric>0.1\"), the exact probability where one exists and whether the rate agrees with it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "test_id",
        "label",
        "scenario",
        "panel",
        "severity",
        "x",
        "rates",
        "exact",
        "agrees",
        "p_histogram",
        "seed",
        "n_rep",
        "generator",
        "study"
      ],
      "properties": {
        "key": {"type": "string"},
        "test_id": {"type": "string", "enum": [
          "ccr.pfe_exceedance_backtest",
          "disc.auc_vs_initial",
          "disc.delong",
          "fair.fisher_exact",
          "fair.two_proportion_z",
          "ifrs9.stage_migration_backtest",
          "lgd_ead.downturn_coverage",
          "lgd_ead.lgd_calibration_by_segment",
          "lgd_ead.lgd_calibration_over_time",
          "market.acerbi_szekely",
          "market.christoffersen_conditional_coverage",
          "market.christoffersen_independence",
          "market.du_escanciano_conditional",
          "market.du_escanciano_unconditional",
          "market.duration_test",
          "market.dynamic_quantile_test",
          "market.kupiec_pof",
          "market.mcneil_frey_residual_test",
          "ml.conformal_coverage",
          "ml.shift_resilience",
          "pd.binomial",
          "pd.binomial_vasicek",
          "pd.chi2_grades",
          "pd.default_profile",
          "pd.hosmer_lemeshow",
          "pd.jeffreys",
          "pd.normal_multiperiod",
          "pd.spiegelhalter",
          "pd.traffic_lights",
          "portfolio.crp_recursion_vs_mc",
          "portfolio.mc_convergence",
          "portfolio.tail_backtest",
          "rating.hhi",
          "rating.markov_order",
          "rating.matrix_reference",
          "rating.migration_ztests",
          "rating.momentum",
          "rating.time_homogeneity",
          "stability.chi2",
          "stability.csi",
          "stability.ks",
          "stability.psi"
        ]},
        "label": {"$ref": "../common/text.schema.json"},
        "scenario": {"$ref": "../common/text.schema.json"},
        "panel": {"type": "string", "enum": [
          "calibration",
          "discrimination",
          "stability",
          "rating",
          "transitions",
          "settings",
          "portfolio",
          "grades",
          "obligors",
          "years",
          "ecb",
          "delong",
          "development",
          "auc",
          "feature",
          "migration-500",
          "migration-2000",
          "curve",
          "counts",
          "ccr",
          "ifrs9",
          "lgd-ead",
          "market-var",
          "market-es",
          "portfolio-credit",
          "fairness",
          "ml"
        ]},
        "severity": {"type": "integer"},
        "x": {"type": "number"},
        "rates": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/c22Rate"}
        },
        "exact": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {"type": "number"}
            },
            {"type": "null"}
          ]
        },
        "agrees": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {"type": "boolean"}
            },
            {"type": "null"}
          ]
        },
        "p_histogram": {
          "anyOf": [
            {
              "type": "array",
              "items": {"type": "integer"}
            },
            {"type": "null"}
          ]
        },
        "seed": {"type": "integer"},
        "n_rep": {"type": "integer", "minimum": 0},
        "generator": {"type": "string"},
        "study": {
          "anyOf": [
            {"$ref": "#/$defs/c22Study"},
            {"type": "null"}
          ]
        }
      }
    },
    "c22Study": {
      "description": "The engine's named study behind a simulation of a test outside the five credit families (riskvalidation.generators.size_studies, U16-E2): its index among the test's studies, its label, the rule of its rejection, which generator ran (the null or the stated alternative) with its text, whether the design is the null alone or the two points of the other-families variant (no study exposes its departure as a parameter), and the engine's documented excess where there is one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["index","label","rule","rule_label","arm","text","departure","excess"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "label": {"$ref": "../common/text.schema.json"},
        "rule": {"type": "string", "enum": ["p","p_le","red","alarm"]},
        "rule_label": {"type": "string", "enum": ["p<0.05","p<=0.05","red","alarm"]},
        "arm": {"type": "string", "enum": ["null","alternative"]},
        "text": {"$ref": "../common/text.schema.json"},
        "departure": {"type": "string", "enum": ["null","two-point"]},
        "excess": {
          "anyOf": [
            {"$ref": "#/$defs/c22Excess"},
            {"type": "null"}
          ]
        }
      }
    },
    "c22Sequential": {
      "description": "The sequential-monitor experiment: the method, the VaR-hit experiment, the PD-book experiment, the three hypotheses with their measured numbers and the verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method","seed","hits","pd_grades","hypotheses","verdict"],
      "properties": {
        "method": {"$ref": "#/$defs/c22SeqMethod"},
        "seed": {"type": "integer"},
        "hits": {"$ref": "#/$defs/c22SeqHits"},
        "pd_grades": {"$ref": "#/$defs/c22SeqPd"},
        "hypotheses": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/c22SeqHypothesis"}},
        "verdict": {"$ref": "#/$defs/c22SeqVerdict"}
      }
    },
    "c22SeqMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine","engine_version","alpha_level","threshold","monitors","label","description"],
      "properties": {
        "engine": {"type": "string"},
        "engine_version": {"type": "string"},
        "alpha_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "The size of the monitor."},
        "threshold": {"type": "number", "exclusiveMinimum": 1, "description": "The value the e-process must reach to reject: 1 / alpha_level."},
        "monitors": {"type": "array", "items": {"type": "string"}},
        "label": {"$ref": "../common/text.schema.json"},
        "description": {"$ref": "../common/text.schema.json"}
      }
    },
    "c22SeqDetection": {
      "description": "How a monitor reads a scenario: the share of series ever rejected, rejected by the early step (day 250, year 3), and the median first-rejection step (null when more than half never reject) and the median among the rejected series.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ever","by","median_day","median_day_among_detected"],
      "properties": {
        "ever": {"type": "number", "minimum": 0, "maximum": 1},
        "by": {"type": "number", "minimum": 0, "maximum": 1},
        "median_day": {"anyOf": [{"type": "number", "minimum": 1}, {"type": "null"}]},
        "median_day_among_detected": {"anyOf": [{"type": "number", "minimum": 1}, {"type": "null"}]}
      }
    },
    "c22SeqHits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alpha","horizon","window","by_day","reps","generator","traffic_light_exceptions","scenarios"],
      "properties": {
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "horizon": {"type": "integer", "minimum": 20},
        "window": {"type": "integer", "minimum": 1},
        "by_day": {"type": "integer", "minimum": 1},
        "reps": {"type": "integer", "minimum": 1},
        "generator": {"type": "string"},
        "traffic_light_exceptions": {"type": "integer", "minimum": 1, "description": "The smallest count of exceptions in the window that is outside the green zone."},
        "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/c22SeqHitScenario"}}
      }
    },
    "c22SeqHitScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","kind","factor","cluster","label","e_rate","e_cluster","e_battery","kupiec_trailing","kupiec_cumulative","traffic_light","independence_trailing","kupiec_one_shot_power"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "enum": ["null","rate","cluster"]},
        "factor": {"anyOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "null"}]},
        "cluster": {"anyOf": [{"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, {"type": "null"}]},
        "label": {"$ref": "../common/text.schema.json"},
        "e_rate": {"$ref": "#/$defs/c22SeqDetection"},
        "e_cluster": {"$ref": "#/$defs/c22SeqDetection"},
        "e_battery": {"$ref": "#/$defs/c22SeqDetection"},
        "kupiec_trailing": {"$ref": "#/$defs/c22SeqDetection"},
        "kupiec_cumulative": {"$ref": "#/$defs/c22SeqDetection"},
        "traffic_light": {"$ref": "#/$defs/c22SeqDetection"},
        "independence_trailing": {"$ref": "#/$defs/c22SeqDetection"},
        "kupiec_one_shot_power": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "c22SeqPd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pd","obligors_per_grade_year","years","by_year","reps","scenarios"],
      "properties": {
        "pd": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
        "obligors_per_grade_year": {"type": "integer", "minimum": 1},
        "years": {"type": "integer", "minimum": 1},
        "by_year": {"type": "integer", "minimum": 1},
        "reps": {"type": "integer", "minimum": 1},
        "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/c22SeqPdScenario"}}
      }
    },
    "c22SeqPdScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","factor","label","e_product","e_average","chi2_one_shot_power","chi2_every_year"],
      "properties": {
        "id": {"type": "string"},
        "factor": {"type": "number", "exclusiveMinimum": 0},
        "label": {"$ref": "../common/text.schema.json"},
        "e_product": {"$ref": "#/$defs/c22SeqDetection"},
        "e_average": {"$ref": "#/$defs/c22SeqDetection"},
        "chi2_one_shot_power": {"type": "number", "minimum": 0, "maximum": 1},
        "chi2_every_year": {"$ref": "#/$defs/c22SeqDetection"}
      }
    },
    "c22SeqHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","holds","rule","measured","values"],
      "properties": {
        "id": {"type": "string", "enum": ["H1","H2","H3"]},
        "holds": {"type": "boolean"},
        "rule": {"$ref": "../common/text.schema.json"},
        "measured": {"$ref": "../common/text.schema.json"},
        "values": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id","value"], "properties": {
          "id": {"type": "string"},
          "value": {"anyOf": [{"type": "number"}, {"type": "null"}]}
        }}}
      }
    },
    "c22SeqVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holds","held","failed","text","scope"],
      "properties": {
        "holds": {"type": "boolean"},
        "held": {"type": "array", "items": {"type": "string", "enum": ["H1","H2","H3"]}},
        "failed": {"type": "array", "items": {"type": "string", "enum": ["H1","H2","H3"]}},
        "text": {"$ref": "../common/text.schema.json"},
        "scope": {"$ref": "../common/text.schema.json"}
      }
    },
    "c22Excess": {
      "description": "A size above its bound that the engine documents on its own page (DOCUMENTED_EXCESS in the engine's size suites): the page, the level, the measured size, the bound, the excess (measured minus bound), whether it exceeds in this run, and the engine's statement.",
      "type": "object",
      "additionalProperties": false,
      "required": ["page","repository","level","measured","bound","excess","exceeds","engine"],
      "properties": {
        "page": {"type": "string"},
        "repository": {"type": "string"},
        "level": {"type": "number"},
        "measured": {"type": "number"},
        "bound": {"type": "number"},
        "excess": {"type": "number"},
        "exceeds": {"type": "boolean"},
        "engine": {"$ref": "../common/text.schema.json"}
      }
    }
  }
}
