{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contraste.fasl-work.com/tests/c18/stress-rungs.schema.json",
  "title": "C18 stress rungs (details of the two sota model records)",
  "description": "The shape of `details` of the c18-var-conditional-forecast and c18-growth-at-risk records of the C18 models document. `details` is open by design in the model record contract; this schema is the producer's and the view's two-sided test of what it carries (plan S-2).",
  "type": "object",
  "required": ["engine_commit", "tier"],
  "properties": {
    "engine_commit": {"type": "string"},
    "tier": {"const": "sota"},
    "statement": {"$ref": "#/$defs/text"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "var": {"$ref": "#/$defs/var"},
    "growth_at_risk": {"$ref": "#/$defs/gar"}
  },
  "oneOf": [
    {"required": ["var", "acceptance", "statement"], "not": {"required": ["growth_at_risk"]}},
    {"required": ["growth_at_risk"], "not": {"required": ["var"]}}
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "object", "required": ["en", "es"], "additionalProperties": false, "properties": {"en": {"type": "string", "minLength": 1}, "es": {"type": "string", "minLength": 1}}},
    "quarter": {"type": "string", "pattern": "^[0-9]{4}-(03-31|06-30|09-30|12-31)$"},
    "light": {"enum": ["green", "amber", "red", "error", "not_evaluated"]},
    "sign": {"enum": ["positive", "negative", "none"]},
    "signCheck": {"type": "object", "additionalProperties": false, "required": ["wrong_signs", "offending", "light"],
      "properties": {"wrong_signs": {"type": "integer", "minimum": 0}, "offending": {"type": "array", "items": {"type": "string"}}, "light": {"$ref": "#/$defs/light"}}},
    "acceptance": {"type": "object", "additionalProperties": false,
      "required": ["leak_free", "complete", "sign_checks_reported", "var_wrong_signs", "var_sign_checks", "gar_wrong_signs", "gar_sign_checks", "met"],
      "properties": {"leak_free": {"type": "boolean"}, "complete": {"type": "boolean"}, "sign_checks_reported": {"type": "boolean"}, "met": {"type": "boolean"},
        "var_wrong_signs": {"type": "integer", "minimum": 0}, "var_sign_checks": {"type": "integer", "minimum": 1},
        "gar_wrong_signs": {"type": "integer", "minimum": 0}, "gar_sign_checks": {"type": "integer", "minimum": 1}}},
    "peak": {"type": "object", "additionalProperties": false,
      "required": ["rmse", "peak_predicted", "peak_predicted_quarter", "peak_realised", "peak_realised_quarter", "peak_timing_error_quarters", "peak_ratio", "light"],
      "properties": {"rmse": {"type": "number", "minimum": 0}, "peak_predicted": {"type": "number"}, "peak_predicted_quarter": {"$ref": "#/$defs/quarter"},
        "peak_realised": {"type": "number"}, "peak_realised_quarter": {"$ref": "#/$defs/quarter"}, "peak_timing_error_quarters": {"type": "integer"},
        "peak_ratio": {"type": ["number", "null"]}, "light": {"$ref": "#/$defs/light"}}},
    "varRow": {"type": "object", "additionalProperties": false,
      "required": ["fed_loan_type", "series_id", "link", "fit_window", "n_obs", "coefficients", "sign_check", "conditioned_on", "full_conditioning_gap_to_ols", "quarters", "metrics", "closer"],
      "properties": {
        "fed_loan_type": {"enum": ["commercial-industrial", "commercial-real-estate", "residential", "credit-cards", "other-consumer"]},
        "series_id": {"enum": ["CI", "RECI", "RERES", "CONCC", "CONOTH"]},
        "link": {"enum": ["probit", "logit", "identity"]},
        "fit_window": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/quarter"}, "end": {"$ref": "#/$defs/quarter"}}},
        "n_obs": {"type": "integer", "minimum": 10},
        "coefficients": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["name", "estimate", "std_error", "expected_sign"],
          "properties": {"name": {"enum": ["intercept", "ar_1", "real_gdp_growth_lag1", "unemployment_rate_lag1"]}, "estimate": {"type": "number"}, "std_error": {"type": "number", "minimum": 0}, "expected_sign": {"$ref": "#/$defs/sign"}}}},
        "sign_check": {"$ref": "#/$defs/signCheck"},
        "conditioned_on": {"const": ["real_gdp_growth"]},
        "full_conditioning_gap_to_ols": {"type": "number", "minimum": 0, "maximum": 1e-9},
        "quarters": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["quarter_end", "var", "ols", "realised", "unemployment_var", "unemployment_realised"],
          "properties": {"quarter_end": {"$ref": "#/$defs/quarter"}, "var": {"type": "number"}, "ols": {"type": "number"}, "realised": {"type": "number"},
            "unemployment_var": {"type": "number"}, "unemployment_realised": {"type": "number"}}}},
        "metrics": {"type": "object", "additionalProperties": false, "required": ["var", "ols", "rmse_ratio_var_over_ols"],
          "properties": {"var": {"$ref": "#/$defs/peak"}, "ols": {"$ref": "#/$defs/peak"}, "rmse_ratio_var_over_ols": {"type": "number", "exclusiveMinimum": 0}}},
        "closer": {"enum": ["var", "ols", "tie"]}}},
    "var": {"type": "object", "additionalProperties": false, "required": ["lags", "variables", "windows", "summary"],
      "properties": {"lags": {"const": 1}, "variables": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 3},
        "windows": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false,
          "required": ["window_id", "label", "fit_end", "start", "end", "per_loan_type"],
          "properties": {"window_id": {"enum": ["gfc-2008-09", "pandemic-2020"]}, "label": {"$ref": "#/$defs/text"}, "fit_end": {"$ref": "#/$defs/quarter"},
            "start": {"$ref": "#/$defs/quarter"}, "end": {"$ref": "#/$defs/quarter"}, "per_loan_type": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/varRow"}}}}},
        "summary": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false,
          "required": ["window_id", "loan_types", "var_closer", "ols_closer", "sign_checks_red"],
          "properties": {"window_id": {"type": "string"}, "loan_types": {"const": 5}, "var_closer": {"type": "integer", "minimum": 0, "maximum": 5},
            "ols_closer": {"type": "integer", "minimum": 0, "maximum": 5}, "sign_checks_red": {"type": "integer", "minimum": 0, "maximum": 5}}}}}},
    "garWindow": {"type": "object", "additionalProperties": false,
      "required": ["window_id", "fit_end", "train_origins", "coefficients", "unconditional_quantiles", "origins", "coverage", "pinball", "mean_pinball_ratio", "crossing_origins",
        "skewed_t_at_first_origin", "first_origin"],
      "properties": {
        "window_id": {"enum": ["gfc-2008-09", "pandemic-2020"]}, "fit_end": {"$ref": "#/$defs/quarter"},
        "train_origins": {"type": "object", "additionalProperties": false, "required": ["first", "last", "n"],
          "properties": {"first": {"$ref": "#/$defs/quarter"}, "last": {"$ref": "#/$defs/quarter"}, "n": {"type": "integer", "minimum": 20}}},
        "coefficients": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["tau", "terms", "sign_check"],
          "properties": {"tau": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "sign_check": {"$ref": "#/$defs/signCheck"},
            "terms": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["name", "estimate", "expected_sign"],
              "properties": {"name": {"enum": ["intercept", "real_gdp_growth", "term_spread"]}, "estimate": {"type": "number"}, "expected_sign": {"$ref": "#/$defs/sign"}}}}}}},
        "unconditional_quantiles": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number"}},
        "origins": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["origin", "target_end", "realised", "quantiles"],
          "properties": {"origin": {"$ref": "#/$defs/quarter"}, "target_end": {"$ref": "#/$defs/quarter"}, "realised": {"type": "number"},
            "quantiles": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number"}}}}},
        "coverage": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["tau", "hits", "n", "rate"],
          "properties": {"tau": {"type": "number"}, "hits": {"type": "integer", "minimum": 0}, "n": {"type": "integer", "minimum": 1}, "rate": {"type": "number", "minimum": 0, "maximum": 1}}}},
        "pinball": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["tau", "conditional", "unconditional", "ratio"],
          "properties": {"tau": {"type": "number"}, "conditional": {"type": "number", "minimum": 0}, "unconditional": {"type": "number", "minimum": 0}, "ratio": {"type": "number", "exclusiveMinimum": 0}}}},
        "mean_pinball_ratio": {"type": "number", "exclusiveMinimum": 0},
        "crossing_origins": {"type": "integer", "minimum": 0},
        "skewed_t_at_first_origin": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["status", "mu", "sigma", "alpha", "nu", "distance"],
            "properties": {"status": {"const": "fitted"}, "mu": {"type": "number"}, "sigma": {"type": "number", "exclusiveMinimum": 0}, "alpha": {"type": "number"},
              "nu": {"type": "number", "exclusiveMinimum": 0}, "distance": {"type": "number", "minimum": 0}}},
          {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "not-fitted"}, "reason": {"type": "string", "minLength": 1}}}]},
        "first_origin": {"type": "object", "additionalProperties": false, "required": ["origin", "realised", "growth_at_risk_5", "below_growth_at_risk"],
          "properties": {"origin": {"$ref": "#/$defs/quarter"}, "realised": {"type": "number"}, "growth_at_risk_5": {"type": "number"}, "below_growth_at_risk": {"type": "boolean"}}}}},
    "gar": {"type": "object", "additionalProperties": false, "required": ["horizon_quarters", "taus", "regressors", "windows", "summary"],
      "properties": {"horizon_quarters": {"const": 4}, "taus": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "number"}},
        "regressors": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "windows": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/garWindow"}},
        "summary": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false,
          "required": ["window_id", "origins", "mean_pinball_ratio", "better_than_unconditional", "first_origin_realised_below_5"],
          "properties": {"window_id": {"type": "string"}, "origins": {"type": "integer", "minimum": 2}, "mean_pinball_ratio": {"type": "number", "exclusiveMinimum": 0},
            "better_than_unconditional": {"type": "boolean"}, "first_origin_realised_below_5": {"type": "boolean"}}}}}}
  }
}
